+####################################################################################################
+# GUILD BANK EXCHANGE
+#
+# Bots in a guild now and then swap ONE random bag item with one slot of a guild bank tab:
+# an empty slot is a plain deposit, an occupied slot gives the bot that item in return.
+# No vault trip; the core does every rights / log / DB step (rank deposit + withdraw rights apply).
+# Eligible: trade goods, or armor / weapons from MinQuality to MaxQuality; never soulbound,
+# quest, conjured or limited-duration items, never equipped / bank / keyring items.
+#
+
+# Enable the exchange
+# Default: 0 (disabled)
+AiPlayerbot.GuildBank.Enabled = 0
+
+# Per-bot timer in seconds (random between Min and Max), then a Chance roll in %
+# Default: 3600, 7200, 50
+AiPlayerbot.GuildBank.MinInterval = 3600
+AiPlayerbot.GuildBank.MaxInterval = 7200
+AiPlayerbot.GuildBank.Chance = 50
+
+# Bank tab used (0 = first tab; the guild must have bought it)
+# Default: 0
+AiPlayerbot.GuildBank.Tab = 0
+
+# Item filters: quality range for armor / weapons (2 = green, 4 = epic), trade goods on / off
+# Default: 2, 4, 1, 1
+AiPlayerbot.GuildBank.MinQuality = 2
+AiPlayerbot.GuildBank.MaxQuality = 4
+AiPlayerbot.GuildBank.TradeGoods = 1
+AiPlayerbot.GuildBank.ArmorWeapons = 1
+
+# Chance in % to use the first free slot instead of a random slot (a random occupied slot is a swap)
+# Default: 50
+AiPlayerbot.GuildBank.PreferEmptyChance = 50
+
+# Chance in % for one guild chat line per exchange (texts guild_bank_deposit / guild_bank_swap)
+# Default: 30
+AiPlayerbot.GuildBank.ChatChance = 30
+
+# "gb <item>" works without a nearby guild vault (the deposit runs on the world thread)
+# Default: 0
+AiPlayerbot.GuildBank.RemoteCommand = 0
+
+# Also non-random bots (altbots)
+# Default: 0
+AiPlayerbot.GuildBank.AltBots = 0
+
+# Prefer armor / weapons the bot cannot use (wrong class / armor type / level)
+# Default: 0
+AiPlayerbot.GuildBank.SmartGive = 0
+
+# Chance in % per swap to aim at a bank item the bot would wear (an equip / replace upgrade for its spec);
+# otherwise the slot is picked as above. A bot that asked for an upgrade (WantChance) always aims.
+# Default: 0
+AiPlayerbot.GuildBank.SmartTakeChance = 0
+
+# Run the bot's normal auto-equip right after it took an upgrade (same choice logic, no forced equip)
+# Default: 0
+AiPlayerbot.GuildBank.EquipAfterTake = 0
+
+# Per-member totals (items in / out, gold in / out / repairs) in table playerbots_guild_ledger;
+# whisper a guild bot "ledger" to see the top 5
+# Default: 0
+AiPlayerbot.GuildBank.Ledger = 0
+
+# "need <item link>" in guild chat: after NeedDelayMin-NeedDelayMax s an online guild bot that carries
+# the item in its bags deposits it into a free slot. NeedUsable 0 = bots keep items they would wear.
+# Default: 0, 60, 600, 1
+AiPlayerbot.GuildBank.NeedRequests = 0
+AiPlayerbot.GuildBank.NeedDelayMin = 60
+AiPlayerbot.GuildBank.NeedDelayMax = 600
+AiPlayerbot.GuildBank.NeedUsable = 1
+
+# Chance in % per timer hit that a bot asks guild chat for an upgrade of its weakest piece, checks the
+# bank again within 10-20 min (for up to 1 h) and thanks the member who deposited what it takes
+# Default: 0
+AiPlayerbot.GuildBank.WantChance = 0
+
+# % of looted gold a bot deposits into the guild bank on its timer
+# Default: 0
+AiPlayerbot.GuildBank.GoldSharePct = 0
+
+# Bots repair from the guild bank first (rank repair rights and daily limit apply), own gold for the rest
+# Default: 0
+AiPlayerbot.GuildBank.GuildRepair = 0
+
+# When the tab is full, a bot takes one grey item out (it sells it on its next vendor visit)
+# Default: 0
+AiPlayerbot.GuildBank.CleanupGreys = 0
+
+#
+#
+####################################################################################################
+
