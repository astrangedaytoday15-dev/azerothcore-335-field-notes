+  `items_in` INT UNSIGNED NOT NULL DEFAULT 0,
+  `items_out` INT UNSIGNED NOT NULL DEFAULT 0,
+  `gold_in` BIGINT UNSIGNED NOT NULL DEFAULT 0 COMMENT 'copper',
+  `gold_out` BIGINT UNSIGNED NOT NULL DEFAULT 0 COMMENT 'copper',
+  `repair_out` BIGINT UNSIGNED NOT NULL DEFAULT 0 COMMENT 'copper',
+  PRIMARY KEY (`guildid`, `guid`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+DELETE FROM `ai_playerbot_texts` WHERE `name` IN ('guild_bank_deposit', 'guild_bank_swap', 'guild_bank_need', 'guild_bank_want', 'guild_bank_thanks');
