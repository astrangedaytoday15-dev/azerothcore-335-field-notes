+
+#ifndef PLAYERBOTS_GUILDBANKEXCHANGEMGR_H
+#define PLAYERBOTS_GUILDBANKEXCHANGEMGR_H
+
+#include "Common.h"
+#include "ObjectGuid.h"
+#include "PlayerbotOperation.h"
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <string>
+#include <vector>
+
+class Guild;
+class Item;
+class Player;
+
+/**
+ * @brief Guild Bank Exchange: guild bots now and then swap one bag item with their guild bank.
+ *
+ * Every bot in a guild gets a timer (MinInterval..MaxInterval seconds). When it runs out and the
+ * Chance roll passes, the bot swaps one random eligible bag item with one slot of the configured
+ * bank tab: an empty slot is a plain deposit, an occupied slot gives the bot that item in return.
+ * No vault trip: the core Guild::SwapItemsWithInventory does every rights / log / DB step.
+ *
+ * Thread safety: bank moves of real players run on the world thread (CMSG_GUILD_BANK_SWAP_ITEMS
+ * is PROCESS_THREADUNSAFE). Update() is called from a WorldScript (world thread, map updates
+ * finished), so the swap is done there directly. The "gb" chat command (bot AI, map thread)
+ * queues a GuildBankDepositOperation on the PlayerbotWorldThreadProcessor when RemoteCommand = 1.
+ *
+ * Tier 2 / 3 (each its own option, default off): SmartTakeChance (aim a swap at a bank item the bot
+ * would wear), equip right after a take, a ledger table, "need <item>" requests in guild chat, bots
+ * asking for upgrades (WantChance), a gold share of looted money, guild bank repairs and taking
+ * greys out of a full tab. The core Guild class keeps bank tabs private, so bank contents are read
+ * from the characters DB (guild_bank_item), which the core keeps in step with every move.
+ */
+struct GuildBankExchangeConfig
+{
+    bool enabled = false;
+    uint32 minInterval = 3600;  // seconds
+    uint32 maxInterval = 7200;
+    uint32 chance = 50;         // % per timer hit
+    uint32 tab = 0;
+    uint32 minQuality = 2;      // green
+    uint32 maxQuality = 4;      // epic
+    bool tradeGoods = true;
+    bool armorWeapons = true;
+    uint32 preferEmptyChance = 50;  // % to use the first free slot instead of a random slot
+    uint32 chatChance = 30;         // % for one guild chat line per swap
+    bool remoteCommand = false;     // "gb <item>" without a nearby vault, via the world thread
+    bool altBots = false;           // also non-random bots
+    bool smartGive = false;         // prefer items the bot cannot use
+    uint32 smartTakeChance = 0;     // % per swap to aim at a bank item the bot would wear
+    bool equipAfterTake = false;    // run the stock auto-equip right after taking an upgrade
+    bool ledger = false;            // per-member totals in playerbots_guild_ledger + "ledger" whisper
+    bool needRequests = false;      // "need <item link>" in guild chat -> a bot that has it deposits it
+    uint32 needDelayMin = 60;       // seconds
+    uint32 needDelayMax = 600;
+    bool needUsable = true;         // bots also give items they could use themselves
+    uint32 wantChance = 0;          // % per timer hit to ask guild chat for an upgrade
+    uint32 goldSharePct = 0;        // % of looted gold deposited on the bot's timer
+    bool guildRepair = false;       // bots repair from the guild bank first (rank repair rights apply)
+    bool cleanupGreys = false;      // take one grey item out of a full tab
+};
+
+struct GuildBankSlotItem
+{
+    uint8 slot;
+    uint32 entry;
+    int32 randomPropertyId;
+};
+
+class GuildBankExchangeMgr
+{
+public:
+    static GuildBankExchangeMgr& instance()
+    {
+        static GuildBankExchangeMgr instance;
+        return instance;
+    }
+
+    void LoadConfig();
+    GuildBankExchangeConfig const& GetConfig() const { return config; }
+
+    // World thread only
+    void Update(uint32 diff);
+    // World thread only: deposit one bag item into the first free slot of the tab; true if it left the bags
+    bool DepositItem(Player* bot, Item* item);
+
+    // Script hooks
+    void OnLootMoney(Player* bot, uint32 gold);  // map thread
+    void OnBankEvent(Guild* guild, uint8 eventType, ObjectGuid::LowType playerGuid, uint32 itemOrMoney,
+                     uint16 count);              // any thread
+    void OnGuildChat(Player* player, std::string const& msg);                  // world thread
+    void OnWhisper(Player* player, Player* receiver, std::string const& msg);  // world thread
+
+private:
+    GuildBankExchangeMgr() = default;
+
+    bool IsEligible(Player* bot, Item* item) const;
+    Item* PickItem(Player* bot) const;
+    bool Exchange(Player* bot);
+    void Announce(Player* bot, uint32 givenEntry, uint32 takenEntry) const;
+    bool IsGuildBot(Player* player) const;
+    std::vector<GuildBankSlotItem> ReadTab(uint32 guildId, uint8 tab) const;
+    int32 PickUpgradeSlot(Player* bot, std::vector<GuildBankSlotItem> const& slots) const;
+    bool IsUpgrade(Player* bot, uint32 entry, int32 randomPropertyId) const;
+    bool TakeGrey(Player* bot, Guild* guild);
+    void ShareGold(Player* bot, Guild* guild);
+    bool AskForUpgrade(Player* bot);
+    void ThankDepositor(Player* bot, uint32 entry);
+    void ProcessNeeds(uint32 now);
+    void Say(Player* bot, std::string const& name, std::string const& defaultText,
+             std::map<std::string, std::string> placeholders) const;
+
+    struct NeedRequest
+    {
+        uint32 due;
+        uint32 guildId;
+        uint32 entry;
+        ObjectGuid::LowType requester;
+    };
+
+    GuildBankExchangeConfig config;
+    uint32 checkTimer = 0;
+    std::unordered_map<ObjectGuid::LowType, uint32> nextExchange;  // bot guid -> game time (s) of the next try
+    std::unordered_map<ObjectGuid::LowType, uint32> wanting;       // bot guid -> game time (s) the ask ends
+    std::vector<NeedRequest> needs;                                // world thread only
+
+    std::mutex goldLock;                                           // OnLootMoney runs on map threads
+    std::unordered_map<ObjectGuid::LowType, uint64> goldPending;   // bot guid -> copper x 100
+
+    std::mutex depositorLock;                                      // OnBankEvent runs on any thread
+    std::unordered_map<uint64, ObjectGuid::LowType> lastDepositor; // (guild << 32 | entry) -> member guid
+};
+
+#define sGuildBankExchangeMgr GuildBankExchangeMgr::instance()
+
+// Queued by the "gb" chat command (map thread), run on the world thread
+class GuildBankDepositOperation : public PlayerbotOperation
+{
+public:
+    GuildBankDepositOperation(ObjectGuid botGuid, ObjectGuid itemGuid) : m_botGuid(botGuid), m_itemGuid(itemGuid) {}
+
+    bool Execute() override;
+    ObjectGuid GetBotGuid() const override { return m_botGuid; }
+    std::string GetName() const override { return "GuildBankDeposit"; }
+    bool IsValid() const override;
+
+private:
+    ObjectGuid m_botGuid;
+    ObjectGuid m_itemGuid;
+};
