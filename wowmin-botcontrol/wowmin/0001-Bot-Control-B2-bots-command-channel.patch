+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const esbuild = require('esbuild');
+
+const output = esbuild.buildSync({
+  entryPoints: [path.join(__dirname, '../src/bot-command.ts')],
+  bundle: true,
+  write: false,
+  platform: 'node',
+  format: 'cjs',
+}).outputFiles[0].text;
+const moduleValue = { exports: {} };
+new Function('module', 'exports', 'require', '__dirname', '__filename', output)(
+  moduleValue,
+  moduleValue.exports,
+  require,
+  __dirname,
+  __filename,
+);
+const {
+  BotCommandSender, buildBotCommandLine, normalizeBotCommand, parseBotCommandReply, parseBotName,
+} = moduleValue.exports;
+
+const plain = (value) => JSON.parse(JSON.stringify(value));
+
+test('a bot name goes into a console command: letters only, 2-12', () => {
+  assert.equal(parseBotName('Tulli'), 'Tulli');
+  assert.equal(parseBotName('Ériel'), 'Ériel');
+  assert.equal(parseBotName('Ab'), 'Ab');
+  assert.equal(parseBotName('Abcdefghijkl'), 'Abcdefghijkl');
+  for (const name of [null, undefined, 42, '', 'A', 'Tulli 1', 'Tulli;kick', 'Tul-li', 'Abcdefghijklm', 'Tulli stay']) {
+    assert.equal(parseBotName(name), null, String(name));
+  }
+});
+
+test('the allowlist mirror matches the module (scope A3)', () => {
+  const allowed = [
+    ['stay', 'self', 'stay'],
+    ['Grind', 'self', 'grind'],
+    ['flee', 'self', 'flee'],
+    ['reset botAI', 'self', 'reset botAI'],
+    ['  reset   BOTAI ', 'self', 'reset botAI'],
+    ['release', 'self', 'release'],
+    ['follow', 'master', 'follow'],
+    ['summon', 'master', 'summon'],
+    ['attack', 'master', 'attack'],
+    ['tank attack', 'master', 'tank attack'],
+    ['co +dps', 'strategy', 'co +dps'],
+    ['co -AOE', 'strategy', 'co -aoe'],
+    ['nc +food', 'strategy', 'nc +food'],
+    ['nc  -food', 'strategy', 'nc -food'],
+    ['nc +rpg 2', 'strategy', 'nc +rpg 2'],
+  ];
+  for (const [text, kind, command] of allowed) {
+    assert.deepEqual(plain(normalizeBotCommand(text)), { kind, command }, text);
+  }
+
+  const refused = [
+    null, '', ' ', 'cheat', 'maintenance', 'autogear', 'destroy', 'drop', 'sendmail', 'mail', 'bank', 'gb',
+    'trade', 'sell', 'teleport', 'taxi', 'go', 'leave', 'logout', 'talents', 'spells', 'invite', 'ginvite',
+    'guild leave', 'give leader', 'debug', 'cdebug', 'do attack', 'lfg', 'rti', 'formation', 'emote',
+    // Command separators and odd characters.
+    'stay\\grind', 'stay;grind', 'stay|grind', 'stay,grind', 'stày', 'stay.',
+    // Strategy forms the module refuses.
+    'co', 'co +', 'co dps', 'co + dps', 'co +dps,aoe', 'co +dps -aoe', 'co ++dps', 'nc +-food', 'xx +dps', 'co+dps',
+  ];
+  for (const text of refused) assert.equal(normalizeBotCommand(text), null, String(text));
+});
+
+test('the console line and the module replies', () => {
+  assert.equal(buildBotCommandLine('Tulli', 'reset botAI'), 'wowmin botcmd Tulli reset botAI');
+  assert.deepEqual(plain(parseBotCommandReply('WBOTCMD|ok|Tulli|stay\r\n')), {
+    success: true, status: 'ok', reply: 'WBOTCMD|ok|Tulli|stay', bot: 'Tulli', command: 'stay',
+  });
+  assert.deepEqual(plain(parseBotCommandReply('WBOTCMD|refused|no such bot online')), {
+    success: false, status: 'refused', reply: 'WBOTCMD|refused|no such bot online', reason: 'no such bot online',
+  });
+  assert.deepEqual(plain(parseBotCommandReply('WBOTCMD|disabled\n')), {
+    success: false, status: 'disabled', reply: 'WBOTCMD|disabled',
+  });
+  assert.equal(parseBotCommandReply('There is no such subcommand').status, 'error');
+  assert.equal(parseBotCommandReply('WBOTCMD|what').status, 'error');
+});
+
+async function senderFixture(replies) {
+  const dataDir = await fs.mkdtemp(path.join(os.tmpdir(), 'wowmin-botcmd-'));
+  const sent = [];
+  const sender = new BotCommandSender(
+    path.join(dataDir, 'data'),
+    async (command) => {
+      sent.push(command);
+      const reply = replies.shift();
+      if (reply instanceof Error) throw reply;
+      return reply;
+    },
+    () => Date.UTC(2026, 9, 21, 12, 0, 0),
+  );
+  const readLog = async () => (await fs.readFile(path.join(dataDir, 'data', 'bot-commands.jsonl'), 'utf8'))
+    .trim().split('\n').map((line) => JSON.parse(line));
+  return { dataDir, sent, sender, readLog };
+}
+
+test('the sender sends the normalized command and logs every sent one', async () => {
+  const { dataDir, sent, sender, readLog } = await senderFixture([
+    { success: true, message: 'WBOTCMD|ok|Tulli|reset botAI' },
+    { success: true, message: 'WBOTCMD|refused|needs the owner as master' },
+    { success: false, message: 'Not connected to the worldserver.' },
+    new Error('socket hang up'),
+  ]);
+  try {
+    const ok = await sender.send('Tulli', 'Reset  BotAI', 'button');
+    assert.equal(ok.status, 'ok');
+    assert.equal(ok.command, 'reset botAI');
+    assert.equal((await sender.send('Tulli', 'follow', 'suggestion')).reason, 'needs the owner as master');
+    assert.equal((await sender.send('Tulli', 'stay', 'text')).status, 'error');
+    const thrown = await sender.send('Tulli', 'grind', 'nonsense');
+    assert.equal(thrown.status, 'error');
+    assert.equal(thrown.reply, 'socket hang up');
+
+    assert.deepEqual(sent, [
+      'wowmin botcmd Tulli reset botAI',
+      'wowmin botcmd Tulli follow',
+      'wowmin botcmd Tulli stay',
+      'wowmin botcmd Tulli grind',
+    ]);
+    const time = '2026-10-21T12:00:00.000Z';
+    assert.deepEqual(await readLog(), [
+      { time, bot: 'Tulli', command: 'reset botAI', reply: 'WBOTCMD|ok|Tulli|reset botAI', source: 'button' },
+      { time, bot: 'Tulli', command: 'follow', reply: 'WBOTCMD|refused|needs the owner as master', source: 'suggestion' },
+      { time, bot: 'Tulli', command: 'stay', reply: 'Not connected to the worldserver.', source: 'text' },
+      { time, bot: 'Tulli', command: 'grind', reply: 'socket hang up', source: 'text' },
+    ]);
+  } finally {
+    await fs.rm(dataDir, { recursive: true, force: true });
+  }
+});
+
+test('the sender refuses a bad name or command without reaching the server', async () => {
+  const { dataDir, sent, sender } = await senderFixture([]);
+  try {
+    assert.deepEqual(plain(await sender.send('Tulli;kick', 'stay', 'text')), {
+      success: false, status: 'refused', reply: '', reason: 'bad bot name',
+    });
+    assert.deepEqual(plain(await sender.send('Tulli', 'cheat', 'text')), {
+      success: false, status: 'refused', reply: '', reason: 'not allowed',
+    });
+    assert.equal((await sender.send('Tulli', 'stay\\sendmail', 'text')).reason, 'not allowed');
+    assert.deepEqual(sent, []);
+    await assert.rejects(fs.access(path.join(dataDir, 'data', 'bot-commands.jsonl')));
+  } finally {
+    await fs.rm(dataDir, { recursive: true, force: true });
+  }
+});
