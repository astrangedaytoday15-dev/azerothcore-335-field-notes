diff --git a/renderer/scripts/utils/bot-command-panel.ts b/renderer/scripts/utils/bot-command-panel.ts
new file mode 100644
index 0000000..3aed000
--- /dev/null
+++ b/renderer/scripts/utils/bot-command-panel.ts
@@ -0,0 +1,275 @@
+import type { BotCommandResult, BotCommandSource } from '../../../src/types/api';
+import {
+  BOT_MASTER_COMMANDS, BOT_PANEL_STRATEGIES, BOT_SELF_COMMANDS,
+  botStrategyPrefix, diffBotStrategies, expectedStrategyChange, normalizeBotCommand,
+} from '../../../src/bot-command-rules';
+
+// Bot control: the owner's command panel for one bot. Built once and
+// updated in place, so a redraw never loses typing or an open list; the module
+// ("wowmin botcmd") is the real check, this only greys out what it refuses.
+
+export interface BotCommandTarget {
+  name: string;
+  // Bot in a group with the owner's character: the master buttons show.
+  masterAllowed: boolean;
+  // The bot's WMB1 sample from an open stream, or null without one.
+  decision: { state: string; strategies: string[] } | null;
+  // Why there is no live data, shown in place of the chips.
+  noLiveData: string;
+}
+
+export type BotCommandSend = (bot: string, command: string, source: BotCommandSource) => Promise<BotCommandResult>;
+
+// A change WMB1 shows is highlighted this long.
+const CHANGED_MS = 4000;
+// A sent strategy change not seen in WMB1 within this long is reported.
+const EXPECT_MS = 5000;
+
+const SELF_LABELS: Record<string, string> = {
+  stay: 'Stay', grind: 'Grind', flee: 'Flee', 'reset botAI': 'Reset AI', release: 'Release',
+};
+const MASTER_LABELS: Record<string, string> = {
+  follow: 'Follow', summon: 'Summon', attack: 'Attack', 'tank attack': 'Tank attack',
+};
+
+function element<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = ''): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  node.className = className;
+  if (text) node.textContent = text;
+  return node;
+}
+
+export class BotCommandPanel {
+  readonly root: HTMLElement;
+  private readonly title: HTMLElement;
+  private readonly body: HTMLElement;
+  private readonly masterRow: HTMLElement;
+  private readonly chips: HTMLElement;
+  private readonly addSelect: HTMLSelectElement;
+  private readonly input: HTMLInputElement;
+  private readonly sendButton: HTMLButtonElement;
+  private readonly reply: HTMLElement;
+  private target: BotCommandTarget | null = null;
+  private busy = false;
+  private chipsKey = '';
+  private addPrefix: 'co' | 'nc' | null | undefined;
+  private lastStrategies: { name: string; strategies: string[] } | null = null;
+  private changed = new Map<string, number>();
+  private expected: { name: string; prefix: 'co' | 'nc'; strategy: string; adding: boolean; at: number } | null = null;
+
+  constructor(
+    private readonly send: BotCommandSend,
+    private readonly onResult: (bot: string, command: string, result: BotCommandResult) => void = () => {},
+    private readonly storageKey: string | null = null,
+  ) {
+    this.root = element('div', 'bot-cmd hidden');
+    const head = element('div', 'bot-cmd-head');
+    this.title = element('span', 'bot-cmd-title', 'Commands');
+    const collapse = element('button', 'btn btn-tiny bot-cmd-collapse', '–');
+    collapse.type = 'button';
+    collapse.title = 'Hide or show the commands';
+    head.append(this.title, collapse);
+    this.body = element('div', 'bot-cmd-body');
+
+    const selfRow = element('div', 'bot-cmd-row');
+    for (const [, command] of BOT_SELF_COMMANDS) selfRow.append(this.commandButton(command, SELF_LABELS[command] ?? command));
+    this.masterRow = element('div', 'bot-cmd-row bot-cmd-master');
+    this.masterRow.title = 'For a bot in your group';
+    for (const command of BOT_MASTER_COMMANDS) this.masterRow.append(this.commandButton(command, MASTER_LABELS[command] ?? command));
+
+    const strategyRow = element('div', 'bot-cmd-strategies');
+    this.chips = element('div', 'bot-cmd-chips');
+    this.addSelect = element('select', 'bot-cmd-add');
+    this.addSelect.title = 'Add a strategy';
+    strategyRow.append(this.chips, this.addSelect);
+
+    const form = element('form', 'bot-cmd-text');
+    this.input = element('input', 'bot-cmd-input');
+    this.input.maxLength = 60;
+    this.input.placeholder = 'One command, e.g. nc +food';
+    this.input.spellcheck = false;
+    this.sendButton = element('button', 'btn btn-tiny', 'Send');
+    this.sendButton.type = 'submit';
+    form.append(this.input, this.sendButton);
+    this.reply = element('div', 'action-result bot-cmd-reply');
+    this.body.append(selfRow, this.masterRow, strategyRow, form, this.reply);
+    this.root.append(head, this.body);
+
+    this.setCollapsed(this.readCollapsed());
+    collapse.addEventListener('click', () => this.setCollapsed(!this.root.classList.contains('collapsed')));
+    this.body.addEventListener('click', (event) => {
+      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-bot-cmd]');
+      if (button && !button.disabled) void this.run(button.dataset.botCmd ?? '', 'button');
+    });
+    this.addSelect.addEventListener('change', () => {
+      const command = this.addSelect.value;
+      this.addSelect.value = '';
+      if (command) void this.run(command, 'button');
+    });
+    this.input.addEventListener('input', () => this.syncInput());
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!this.sendButton.disabled) void this.run(this.input.value, 'text', true);
+    });
+  }
+
+  // null hides the panel.
+  update(target: BotCommandTarget | null, now = performance.now()): void {
+    if (target?.name !== this.target?.name) {
+      this.reply.textContent = '';
+      this.reply.className = 'action-result bot-cmd-reply';
+      this.expected = null;
+      this.changed.clear();
+      this.lastStrategies = null;
+      this.chipsKey = '';
+    }
+    this.target = target;
+    this.root.classList.toggle('hidden', !target);
+    if (!target) return;
+    this.title.textContent = `Commands · ${target.name}`;
+    this.masterRow.hidden = !target.masterAllowed;
+    this.renderStrategies(target, now);
+    this.syncInput();
+  }
+
+  private commandButton(command: string, label: string): HTMLButtonElement {
+    const button = element('button', 'btn btn-tiny', label);
+    button.type = 'button';
+    button.dataset.botCmd = command;
+    button.title = command;
+    return button;
+  }
+
+  private renderStrategies(target: BotCommandTarget, now: number): void {
+    const decision = target.decision;
+    const prefix = botStrategyPrefix(decision?.state);
+    if (decision) {
+      const previous = this.lastStrategies?.name === target.name ? this.lastStrategies.strategies : null;
+      if (previous) {
+        const { added, removed } = diffBotStrategies(previous, decision.strategies);
+        for (const name of [...added, ...removed]) this.changed.set(name, now);
+      }
+      this.lastStrategies = { name: target.name, strategies: decision.strategies };
+      this.checkExpected(target.name, prefix, decision.strategies, now);
+    }
+    for (const [name, at] of this.changed) if (now - at > CHANGED_MS) this.changed.delete(name);
+
+    const key = decision
+      ? `${prefix}|${decision.strategies.join(',')}|${[...this.changed.keys()].sort().join(',')}`
+      : `none|${target.noLiveData}`;
+    if (key !== this.chipsKey) {
+      this.chipsKey = key;
+      this.chips.replaceChildren();
+      if (!decision) {
+        this.chips.append(element('span', 'bot-cmd-hint', target.noLiveData));
+      } else {
+        const label = prefix === 'co' ? 'In combat' : prefix === 'nc' ? 'Out of combat' : 'While dead';
+        this.chips.append(element('span', 'bot-cmd-hint', `${label}:`));
+        for (const strategy of decision.strategies) {
+          const chip = element('button', `bot-cmd-chip${this.changed.has(strategy) ? ' changed' : ''}`, strategy);
+          chip.type = 'button';
+          if (prefix && normalizeBotCommand(`${prefix} -${strategy}`)) {
+            chip.dataset.botCmd = `${prefix} -${strategy}`;
+            chip.title = `Remove (${prefix} -${strategy})`;
+          } else {
+            chip.disabled = true;
+          }
+          this.chips.append(chip);
+        }
+        if (!decision.strategies.length) this.chips.append(element('span', 'bot-cmd-hint', 'none'));
+      }
+    }
+
+    if (prefix !== this.addPrefix) {
+      this.addPrefix = prefix;
+      const options = prefix ? BOT_PANEL_STRATEGIES[prefix] : [];
+      this.addSelect.replaceChildren(new Option('+', ''), ...options.map((name) => new Option(name, `${prefix} +${name}`)));
+    }
+    const active = new Set(decision?.strategies ?? []);
+    for (const option of Array.from(this.addSelect.options).slice(1)) option.disabled = active.has(option.text);
+    this.addSelect.hidden = !prefix;
+  }
+
+  private checkExpected(name: string, prefix: 'co' | 'nc' | null, strategies: string[], now: number): void {
+    const expected = this.expected;
+    if (!expected || expected.name !== name) return;
+    if (expected.prefix === prefix && strategies.includes(expected.strategy) === expected.adding) {
+      this.expected = null;
+      this.changed.set(expected.strategy, now);
+      this.showReply(true, `${this.reply.textContent} · seen in live data`);
+    } else if (now - expected.at > EXPECT_MS) {
+      this.expected = null;
+      this.showReply(true, `${this.reply.textContent} · not seen in live data yet (the bot may be in the other state, or the random bot manager changed it back)`);
+    }
+  }
+
+  private syncInput(): void {
+    const disabled = this.busy || !this.target;
+    for (const button of Array.from(this.body.querySelectorAll<HTMLButtonElement>('.bot-cmd-row [data-bot-cmd]'))) button.disabled = disabled;
+    this.addSelect.disabled = disabled;
+    const text = this.input.value.trim();
+    const allowed = Boolean(text) && Boolean(normalizeBotCommand(text));
+    this.sendButton.disabled = disabled || !allowed;
+    this.input.classList.toggle('refused', Boolean(text) && !allowed);
+    this.input.title = text && !allowed ? 'Not on the allowlist' : '';
+  }
+
+  private async run(command: string, source: BotCommandSource, fromInput = false): Promise<void> {
+    const target = this.target;
+    if (!target || this.busy) return;
+    this.busy = true;
+    this.syncInput();
+    let result: BotCommandResult;
+    try {
+      result = await this.send(target.name, command.trim(), source);
+    } catch (error) {
+      result = { success: false, status: 'error', reply: error instanceof Error ? error.message : String(error) };
+    }
+    this.busy = false;
+    if (this.target?.name === target.name) {
+      if (result.success && fromInput) this.input.value = '';
+      this.showReply(result.success, describeBotCommandResult(result));
+      const change = result.success && result.command ? expectedStrategyChange(result.command) : null;
+      this.expected = change
+        ? { name: target.name, prefix: change.prefix, strategy: change.name, adding: change.adding, at: performance.now() }
+        : null;
+    }
+    this.syncInput();
+    this.onResult(target.name, command.trim(), result);
+  }
+
+  private showReply(ok: boolean, text: string): void {
+    this.reply.textContent = text;
+    this.reply.className = `action-result bot-cmd-reply visible ${ok ? 'ok' : 'err'}`;
+  }
+
+  private readCollapsed(): boolean {
+    if (!this.storageKey) return false;
+    try {
+      return localStorage.getItem(this.storageKey) === '1';
+    } catch {
+      return false;
+    }
+  }
+
+  private setCollapsed(collapsed: boolean): void {
+    this.root.classList.toggle('collapsed', collapsed);
+    if (!this.storageKey) return;
+    try {
+      localStorage.setItem(this.storageKey, collapsed ? '1' : '0');
+    } catch {
+      // Remembering is a convenience only.
+    }
+  }
+}
+
+export function describeBotCommandResult(result: BotCommandResult): string {
+  switch (result.status) {
+    case 'ok': return `ok: ${result.command ?? ''}`;
+    case 'refused': return `refused: ${result.reason ?? ''}`;
+    case 'disabled': return result.reason
+      ? `off: ${result.reason}`
+      : 'off: WowMinTelemetry.BotCommand.Enable = 0 on the server';
+    default: return `error: ${result.reply || 'no reply'}`;
+  }
+}
