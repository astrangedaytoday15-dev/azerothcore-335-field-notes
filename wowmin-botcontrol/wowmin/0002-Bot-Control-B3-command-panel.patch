diff --git a/src/bot-command-rules.ts b/src/bot-command-rules.ts
new file mode 100644
index 0000000..f810f49
--- /dev/null
+++ b/src/bot-command-rules.ts
@@ -0,0 +1,118 @@
+import type { BotCommandKind, BotCommandResult, BotCommandSource } from './types/api';
+
+// Bot control: one playerbot command sent through mod-wowmin-telemetry's
+// "wowmin botcmd". The module's allowlist (NormalizeBotCommand in
+// WowMinTelemetry.cpp) is the real check; this mirror only lets the UI grey out
+// and skip what the server would refuse.
+
+export const BOT_SELF_COMMANDS: ReadonlyArray<readonly [string, string]> = [
+  ['stay', 'stay'],
+  ['grind', 'grind'],
+  ['flee', 'flee'],
+  ['reset botai', 'reset botAI'],
+  ['release', 'release'],
+];
+// Master commands act for the bot's master, who must be on the owner's account.
+export const BOT_MASTER_COMMANDS: ReadonlyArray<string> = ['follow', 'summon', 'attack', 'tank attack'];
+export const BOT_COMMAND_SOURCES: ReadonlyArray<BotCommandSource> = ['button', 'text', 'suggestion'];
+
+export interface NormalizedBotCommand {
+  kind: BotCommandKind;
+  command: string;
+}
+
+// A bot's name from untrusted input (it goes into a console command): letters
+// only, 2-12, as parseStreamFollow.
+export function parseBotName(name: unknown): string | null {
+  return typeof name === 'string' && /^\p{L}{2,12}$/u.test(name) ? name : null;
+}
+
+// The command as the module sends it to playerbots, or null when the module
+// would answer "not allowed". Words are rejoined with single spaces, as the
+// module reads them.
+export function normalizeBotCommand(text: unknown): NormalizedBotCommand | null {
+  if (typeof text !== 'string') return null;
+  const joined = text.split(/\s+/).filter(Boolean).join(' ');
+  // Letters, digits, spaces, + and - only: no command separators.
+  if (!/^[A-Za-z0-9 +-]+$/.test(joined)) return null;
+  const lower = joined.toLowerCase();
+
+  for (const [name, sent] of BOT_SELF_COMMANDS) {
+    if (lower === name) return { kind: 'self', command: sent };
+  }
+  if (BOT_MASTER_COMMANDS.includes(lower)) return { kind: 'master', command: lower };
+
+  // "co +<s>", "co -<s>", "nc +<s>", "nc -<s>": one strategy at a time. The
+  // module also checks the name against the bot's supported strategies.
+  if (lower.length > 4 && /^(co|nc) [+-]/.test(lower)) {
+    const name = lower.slice(4);
+    if (name.startsWith(' ') || /[+-]/.test(name)) return null;
+    return { kind: 'strategy', command: lower };
+  }
+  return null;
+}
+
+export function buildBotCommandLine(bot: string, command: string): string {
+  return `wowmin botcmd ${bot} ${command}`;
+}
+
+// The module's reply: "WBOTCMD|ok|<bot>|<command>", "WBOTCMD|refused|<reason>"
+// or "WBOTCMD|disabled". Anything else is an error.
+export function parseBotCommandReply(message: string): BotCommandResult {
+  const reply = message.split(/[\r\n]+/).map((line) => line.trim()).find((line) => line.startsWith('WBOTCMD|'));
+  if (!reply) return { success: false, status: 'error', reply: message.trim() };
+  const [, status, ...rest] = reply.split('|');
+  if (status === 'ok' && rest.length >= 2) {
+    return { success: true, status: 'ok', reply, bot: rest[0], command: rest.slice(1).join('|') };
+  }
+  if (status === 'refused') return { success: false, status: 'refused', reply, reason: rest.join('|') };
+  if (status === 'disabled') return { success: false, status: 'disabled', reply };
+  return { success: false, status: 'error', reply };
+}
+
+// ── Command panel helpers (renderer) ──────────────────────────────────────
+
+// Strategy names offered by the panel's "+" list, checked against
+// mod-playerbots StrategyContext.h (037c01418b5d); behaviour only. The text box takes
+// any other name the module allows.
+export const BOT_PANEL_STRATEGIES: Readonly<Record<'co' | 'nc', ReadonlyArray<string>>> = {
+  co: ['aoe', 'avoid aoe', 'behind', 'close', 'kite', 'potions', 'ranged', 'threat'],
+  nc: ['food', 'gather', 'grind', 'loot', 'mount', 'quest', 'rpg', 'sit'],
+};
+
+// WMB1 sends the strategies of the bot's current state: combat ones in combat
+// ("co"), the others when idle ("nc"). A dead bot's cannot be changed here.
+export function botStrategyPrefix(state: string | null | undefined): 'co' | 'nc' | null {
+  if (state === 'combat') return 'co';
+  if (state === 'idle') return 'nc';
+  return null;
+}
+
+export interface BotGroupMember {
+  isBot: boolean;
+  accountId: number;
+  groupId?: number;
+}
+
+// Master commands need the bot in a group with the owner's character online.
+// Without an owner account set, any real player in the group counts; the
+// module still checks its own OwnerAccount.
+export function canUseMasterCommands(bot: BotGroupMember, players: ReadonlyArray<BotGroupMember>, ownerAccountId: number): boolean {
+  if (!bot.isBot || !bot.groupId) return false;
+  return players.some((player) => !player.isBot && player.groupId === bot.groupId
+    && (!ownerAccountId || player.accountId === ownerAccountId));
+}
+
+// What changed between two strategy samples of one bot.
+export function diffBotStrategies(before: ReadonlyArray<string>, after: ReadonlyArray<string>): { added: string[]; removed: string[] } {
+  return {
+    added: after.filter((strategy) => !before.includes(strategy)),
+    removed: before.filter((strategy) => !after.includes(strategy)),
+  };
+}
+
+// The strategy a sent "co +x" / "nc -x" expects to see, or null.
+export function expectedStrategyChange(command: string): { prefix: 'co' | 'nc'; name: string; adding: boolean } | null {
+  const match = /^(co|nc) ([+-])(.+)$/.exec(command);
+  return match ? { prefix: match[1] as 'co' | 'nc', name: match[3], adding: match[2] === '+' } : null;
+}
