+// Group steering: one bar in World 3D and one in Instance Watch.
+function createGroupBar(parent: HTMLElement | null, className: string): BotGroupBar {
+  const bar = new BotGroupBar({
+    command: (bot, command, source) => window.wowminAPI.bots.command(bot, command, source),
+    mark: (player, icon, target, source) => window.wowminAPI.bots.mark(player, icon, target, source),
+  }, onBotCommandResult);
+  bar.root.classList.add(className);
+  parent?.append(bar.root);
+  return bar;
+}
+
+// Screen points of the live mobs drawn last, for the Mark tool.
+interface CreatureHitArea {
+  guid: number;
+  entry: number;
+  x: number;
+  y: number;
+}
+const CREATURE_HIT_RADIUS = 16;
+
+function findCreatureHit(areas: CreatureHitArea[], x: number, y: number): CreatureHitArea | null {
+  let best: CreatureHitArea | null = null;
+  let bestDistance = CREATURE_HIT_RADIUS;
+  for (const area of areas) {
+    const distance = Math.hypot(area.x - x, area.y - y);
+    if (distance <= bestDistance) {
+      best = area;
+      bestDistance = distance;
+    }
+  }
+  return best;
+}
