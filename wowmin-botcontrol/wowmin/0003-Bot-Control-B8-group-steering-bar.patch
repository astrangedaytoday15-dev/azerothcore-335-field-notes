+// The floor under a canvas point: the 3D scene's surface, or on the flat map
+// the point at the leader's height (the module finds the ground near it).
+function getInstanceGroundPoint(x: number, y: number): [number, number, number] | null {
+  const ground = instanceGroundContext;
+  if (!ground) return null;
+  if (ground.iso) {
+    if (!instanceIsoContext) return null;
+    const { view, width, height } = instanceIsoContext;
