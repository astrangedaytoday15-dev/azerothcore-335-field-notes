@@ -0,0 +1,316 @@
+import type { BotCommandResult, BotCommandSource, BotMarkTarget } from '../../../src/types/api';
+import {
+  buildMoveCommand, findNearestMarkable, type MarkableCreature, squadMovePoints,
+} from '../../../src/bot-command-rules';
+import { describeBotCommandResult } from './bot-command-panel';
+
+// Group steering: steering the owner's group. LEADER mode moves
+// the owner's character as a self-bot and the group follows it; SQUAD mode
+// parks the bots ("stay") and moves them to points. Marks put a raid icon on
+// a mob for the group; bots attack the skull by default. The module checks
+// every command again.
+
+export type GroupMode = 'leader' | 'squad';
+export type GroupTool = 'move' | 'mark' | null;
+
+export interface GroupBarContext {
+  // The owner's character, or null when it is not in view.
+  leader: { name: string; x: number; y: number; z: number } | null;
+  // The bots in the leader's group, in view.
+  bots: string[];
+  // A selected group bot: Squad moves only it.
+  selectedBot: string | null;
+  // Live creatures for "Mark nearest"; empty without the stream.
+  creatures: MarkableCreature[];
+}
+
+export interface GroupBarApi {
+  command: (bot: string, command: string, source: BotCommandSource) => Promise<BotCommandResult>;
+  mark: (player: string, icon: string, target: BotMarkTarget | null, source: BotCommandSource) => Promise<BotCommandResult>;
+}
+
+// Playerbots' default rti target, which the bots attack.
+const MARK_ICON = 'skull';
+// "Mark nearest" looks this far round the leader (the module allows up to
+// playerbots' sightDistance).
+const MARK_NEAREST_YARDS = 60;
+// The module takes one command per bot per second.
+const PER_BOT_MS = 1050;
+const MODE_STORAGE_KEY = 'wowmin.botGroup.mode';
+
+function element<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = ''): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  node.className = className;
+  if (text) node.textContent = text;
+  return node;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export class BotGroupBar {
+  readonly root: HTMLElement;
+  private readonly modeButtons: Record<GroupMode, HTMLButtonElement>;
+  private readonly toolButtons: Record<'move' | 'mark', HTMLButtonElement>;
+  private readonly actionButtons: HTMLButtonElement[] = [];
+  private readonly reply: HTMLElement;
+  private readonly hint: HTMLElement;
+  private context: GroupBarContext | null = null;
+  private mode: GroupMode = 'leader';
+  private armed: GroupTool = null;
+  private busy = false;
+  private readonly lastSent = new Map<string, number>();
+
+  constructor(
+    private readonly api: GroupBarApi,
+    private readonly onResult: (bot: string, command: string, result: BotCommandResult) => void = () => {},
+  ) {
+    this.root = element('div', 'bot-group hidden');
+    const head = element('div', 'bot-group-head');
+    head.append(element('span', 'bot-cmd-title', 'Group'));
+    const modes = element('div', 'bot-group-modes');
+    this.modeButtons = {
+      leader: this.button('Leader', 'Move your character (a self-bot); the group follows. Switching sends "follow" to the group bots.'),
+      squad: this.button('Squad', 'Your character stays put; the bots hold and move to points. Switching sends "stay" to the group bots.'),
+    };
+    modes.append(this.modeButtons.leader, this.modeButtons.squad);
+    head.append(modes);
+
+    const tools = element('div', 'bot-cmd-row');
+    this.toolButtons = {
+      move: this.button('Move', 'Then click the ground (Esc cancels)'),
+      mark: this.button('Mark', 'Then click a mob: skull (Esc cancels)'),
+    };
+    const nearest = this.button('Mark nearest', 'Skull on the nearest live hostile mob to your character, like Tab');
+    const clear = this.button('Clear mark', 'Remove the skull');
+    const hold = this.button('Hold', 'Leader: your character stays. Squad: every bot stays.');
+    const regroup = this.button('Regroup', 'Every group bot follows your character again (Leader mode)');
+    tools.append(this.toolButtons.move, this.toolButtons.mark, nearest, clear, hold, regroup);
+    this.actionButtons.push(this.toolButtons.move, this.toolButtons.mark, nearest, clear, hold, regroup,
+      this.modeButtons.leader, this.modeButtons.squad);
+
+    this.hint = element('div', 'bot-cmd-hint');
+    this.reply = element('div', 'action-result bot-cmd-reply');
+    this.root.append(head, tools, this.hint, this.reply);
+
+    try {
+      if (localStorage.getItem(MODE_STORAGE_KEY) === 'squad') this.mode = 'squad';
+    } catch {
+      // Remembering the mode is a convenience only.
+    }
+    this.modeButtons.leader.addEventListener('click', () => void this.setMode('leader'));
+    this.modeButtons.squad.addEventListener('click', () => void this.setMode('squad'));
+    this.toolButtons.move.addEventListener('click', () => this.arm(this.armed === 'move' ? null : 'move'));
+    this.toolButtons.mark.addEventListener('click', () => this.arm(this.armed === 'mark' ? null : 'mark'));
+    nearest.addEventListener('click', () => void this.markNearest());
+    clear.addEventListener('click', () => void this.clearMark());
+    hold.addEventListener('click', () => void this.hold());
+    regroup.addEventListener('click', () => void this.regroup());
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.armed) this.arm(null);
+    });
+    this.sync();
+  }
+
+  // The armed tool: the view sends its next click here.
+  get tool(): GroupTool {
+    return this.context ? this.armed : null;
+  }
+
+  update(context: GroupBarContext | null): void {
+    this.context = context;
+    this.root.classList.toggle('hidden', !context);
+    if (!context) this.armed = null;
+    this.sync();
+  }
+
+  // A click on the ground with the Move tool armed; null = nothing there.
+  async onGroundClick(point: [number, number, number] | null): Promise<void> {
+    if (this.armed !== 'move') return;
+    this.arm(null);
+    const context = this.context;
+    if (!context) return;
+    if (!point) {
+      this.showReply(false, 'No ground there: click on the floor.');
+      return;
+    }
+    const [x, y, z] = point;
+    if (this.mode === 'leader') {
+      if (!context.leader) return;
+      await this.send([[context.leader.name, buildMoveCommand(x, y, z)]], 'Move');
+      return;
+    }
+    const bots = context.selectedBot && context.bots.includes(context.selectedBot) ? [context.selectedBot] : context.bots;
+    const points = squadMovePoints(x, y, z, bots.length);
+    await this.send(bots.map((bot, index) => [bot, buildMoveCommand(...points[index])]), 'Move');
+  }
+
+  // A click on a mob with the Mark tool armed; null = no mob there.
+  async onCreatureClick(creature: BotMarkTarget | null): Promise<void> {
+    if (this.armed !== 'mark') return;
+    this.arm(null);
+    if (!creature) {
+      this.showReply(false, 'No mob there: click on one.');
+      return;
+    }
+    await this.markTarget(creature, 'Mark');
+  }
+
+  private button(label: string, title: string): HTMLButtonElement {
+    const button = element('button', 'btn btn-tiny', label);
+    button.type = 'button';
+    button.title = title;
+    return button;
+  }
+
+  private arm(tool: GroupTool): void {
+    this.armed = tool;
+    this.sync();
+  }
+
+  private sync(): void {
+    const context = this.context;
+    const disabled = this.busy || !context?.leader;
+    for (const button of this.actionButtons) button.disabled = disabled;
+    if (context?.leader && !context.bots.length) {
+      this.modeButtons.squad.disabled = true;
+      if (this.mode === 'squad') this.mode = 'leader';
+    }
+    for (const mode of ['leader', 'squad'] as const) {
+      this.modeButtons[mode].setAttribute('aria-pressed', String(this.mode === mode));
+    }
+    for (const tool of ['move', 'mark'] as const) {
+      this.toolButtons[tool].setAttribute('aria-pressed', String(this.armed === tool));
+    }
+    this.root.classList.toggle('armed', Boolean(this.armed));
+    this.hint.textContent = !context
+      ? ''
+      : !context.leader
+        ? 'Your character is not in view (WOWMIN_BOT_OWNER_ACCOUNT).'
+        : this.armed === 'move'
+          ? `Click the ground: ${this.mode === 'leader' ? context.leader.name : this.squadLabel(context)} moves there.`
+          : this.armed === 'mark'
+            ? 'Click a mob to put the skull on it.'
+            : this.mode === 'leader'
+              ? `Leader: ${context.leader.name} (self-bot), ${context.bots.length} bot${context.bots.length === 1 ? '' : 's'} following.`
+              : `Squad: ${this.squadLabel(context)} hold and move to points.`;
+  }
+
+  private squadLabel(context: GroupBarContext): string {
+    return context.selectedBot && context.bots.includes(context.selectedBot)
+      ? context.selectedBot
+      : `${context.bots.length} bot${context.bots.length === 1 ? '' : 's'}`;
+  }
+
+  private async setMode(mode: GroupMode): Promise<void> {
+    const context = this.context;
+    if (!context || mode === this.mode) return;
+    this.mode = mode;
+    try {
+      localStorage.setItem(MODE_STORAGE_KEY, mode);
+    } catch {
+      // Remembering the mode is a convenience only.
+    }
+    this.sync();
+    await this.send(context.bots.map((bot) => [bot, mode === 'squad' ? 'stay' : 'follow']), mode === 'squad' ? 'Squad' : 'Leader');
+  }
+
+  private async hold(): Promise<void> {
+    const context = this.context;
+    if (!context?.leader) return;
+    await this.send(this.mode === 'leader' ? [[context.leader.name, 'stay']] : context.bots.map((bot) => [bot, 'stay']), 'Hold');
+  }
+
+  private async regroup(): Promise<void> {
+    const context = this.context;
+    if (!context) return;
+    if (this.mode === 'squad') {
+      this.mode = 'leader';
+      try {
+        localStorage.setItem(MODE_STORAGE_KEY, this.mode);
+      } catch {
+        // Remembering the mode is a convenience only.
+      }
+    }
+    await this.send(context.bots.map((bot) => [bot, 'follow']), 'Regroup');
+  }
+
+  private async markNearest(): Promise<void> {
+    const context = this.context;
+    if (!context?.leader) return;
+    const creature = findNearestMarkable(context.creatures, context.leader, MARK_NEAREST_YARDS);
+    if (!creature) {
+      this.showReply(false, context.creatures.length
+        ? `No live hostile mob within ${MARK_NEAREST_YARDS} yd.`
+        : 'No live mob data: open the stream (World 3D follow or Instance Watch).');
+      return;
+    }
+    await this.markTarget({ entry: creature.entry, unitId: creature.guid }, 'Mark nearest');
+  }
+
+  private async clearMark(): Promise<void> {
+    await this.markTarget(null, 'Clear mark');
+  }
+
+  private async markTarget(target: BotMarkTarget | null, label: string): Promise<void> {
+    const leader = this.context?.leader;
+    if (!leader || this.busy) return;
+    this.busy = true;
+    this.sync();
+    let result: BotCommandResult;
+    try {
+      result = await this.api.mark(leader.name, MARK_ICON, target, 'group');
+    } catch (error) {
+      result = { success: false, status: 'error', reply: error instanceof Error ? error.message : String(error) };
+    }
+    this.busy = false;
+    this.onResult(leader.name, target ? `mark ${MARK_ICON}` : `clear ${MARK_ICON}`, result);
+    this.showReply(result.success, `${label}: ${describeBotCommandResult(result)}`);
+    this.sync();
+  }
+
+  // Sends each [bot, command] in turn, a bot's second command a second after
+  // its first (the module's rate limit), and sums the replies up.
+  private async send(commands: Array<[string, string]>, label: string): Promise<void> {
+    if (this.busy) return;
+    if (!commands.length) {
+      this.showReply(false, `${label}: no group bots in view.`);
+      return;
+    }
+    this.busy = true;
+    this.sync();
+    const failures: string[] = [];
+    let ok = 0;
+    for (const [bot, command] of commands) {
+      const wait = (this.lastSent.get(bot) ?? 0) + PER_BOT_MS - Date.now();
+      if (wait > 0) await delay(wait);
+      let result: BotCommandResult;
+      try {
+        result = await this.api.command(bot, command, 'group');
+      } catch (error) {
+        result = { success: false, status: 'error', reply: error instanceof Error ? error.message : String(error) };
+      }
+      this.lastSent.set(bot, Date.now());
+      this.onResult(bot, command, result);
+      if (result.success) ok += 1;
+      else failures.push(`${bot}: ${describeLeaderHint(result, bot === this.context?.leader?.name)}`);
+    }
+    this.busy = false;
+    this.showReply(!failures.length, `${label}: ${ok}/${commands.length} ok${failures.length ? ` · ${failures.join(' · ')}` : ''}`);
+    this.sync();
+  }
+
+  private showReply(ok: boolean, text: string): void {
+    this.reply.textContent = text;
+    this.reply.className = `action-result bot-cmd-reply visible ${ok ? 'ok' : 'err'}`;
+  }
+}
+
+// The module refuses the owner's character unless it is a self-bot.
+function describeLeaderHint(result: BotCommandResult, isLeader: boolean): string {
+  if (isLeader && result.status === 'refused' && (result.reason === 'no such bot online' || result.reason === 'not a bot')) {
+    return 'not a self-bot: type .playerbots bot self in game';
+  }
+  return describeBotCommandResult(result);
+}
