+  creatures: ReadonlyArray<T>,
+  from: { x: number; y: number; z: number },
+  maxYards: number,
+): T | null {
+  let best: T | null = null;
+  let bestDistance = maxYards;
+  for (const creature of creatures) {
+    if (!creature.alive || !creature.hostile || creature.playerControlled || creature.scenery) continue;
+    const distance = Math.hypot(creature.x - from.x, creature.y - from.y, creature.z - from.z);
+    if (distance <= bestDistance) {
+      best = creature;
+      bestDistance = distance;
+    }
+  }
+  return best;
+}
+
+// Where each of `count` bots goes round a squad move point: the point itself
+// for one, else a ring of `radius` yards, so they do not stand in each other.
+export function squadMovePoints(x: number, y: number, z: number, count: number, radius = 2.5): Array<[number, number, number]> {
+  if (count <= 1) return count === 1 ? [[x, y, z]] : [];
+  return Array.from({ length: count }, (_, index) => {
+    const angle = (index / count) * Math.PI * 2;
+    return [x + Math.cos(angle) * radius, y + Math.sin(angle) * radius, z];
+  });
+}
+
+// The world x / y under screen point (sx, sy) for a flat map projection
+// (affine in x and y at a given z); null when the projection is degenerate.
+export function invertFlatProjection(
+  worldToScreen: (x: number, y: number, z: number) => { x: number; y: number },
+  sx: number,
+  sy: number,
+  z: number,
+): { x: number; y: number } | null {
+  const origin = worldToScreen(0, 0, z);
+  const alongX = worldToScreen(100, 0, z);
+  const alongY = worldToScreen(0, 100, z);
+  const ax = (alongX.x - origin.x) / 100;
+  const ay = (alongX.y - origin.y) / 100;
+  const bx = (alongY.x - origin.x) / 100;
+  const by = (alongY.y - origin.y) / 100;
+  const determinant = ax * by - bx * ay;
+  if (!Number.isFinite(determinant) || Math.abs(determinant) < 1e-9) return null;
+  const dx = sx - origin.x;
+  const dy = sy - origin.y;
+  return { x: (dx * by - bx * dy) / determinant, y: (ax * dy - dx * ay) / determinant };
+}
