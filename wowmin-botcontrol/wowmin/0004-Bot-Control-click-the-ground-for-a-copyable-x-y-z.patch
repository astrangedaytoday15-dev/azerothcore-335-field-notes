diff --git a/renderer/scripts/utils/point-popup.ts b/renderer/scripts/utils/point-popup.ts
new file mode 100644
index 0000000..bcc1738
--- /dev/null
+++ b/renderer/scripts/utils/point-popup.ts
@@ -0,0 +1,116 @@
+import { formatPointText, type PointTextStyle } from '../../../src/bot-command-rules';
+
+// The world point under a plain click on the ground (World 3D, Instance
+// Watch): x y z to read or select, and buttons that copy it as is, as the bot
+// panel's "moveto x y z", or as "go x;y;z" for a whisper to a bot in game.
+// Esc or x closes it; the next click replaces it.
+
+const COPY_BUTTONS: ReadonlyArray<readonly [PointTextStyle, string, string]> = [
+  ['xyz', 'Copy', 'Copy "x y z"'],
+  ['moveto', 'moveto', 'Copy "moveto x y z" for a bot panel\'s text box'],
+  ['go', 'go', 'Copy "go x;y;z" to whisper a bot in game'],
+];
+
+export class PointPopup {
+  readonly root: HTMLElement;
+  private readonly text: HTMLInputElement;
+  private readonly status: HTMLElement;
+  private point: [number, number, number] | null = null;
+  private statusTimer: ReturnType<typeof setTimeout> | null = null;
+
+  constructor(private readonly container: HTMLElement) {
+    this.root = document.createElement('div');
+    this.root.className = 'point-popup';
+    this.root.hidden = true;
+    this.text = document.createElement('input');
+    this.text.className = 'point-popup-text';
+    this.text.readOnly = true;
+    this.text.setAttribute('aria-label', 'Clicked point: x y z');
+    const close = this.button('×', 'Close (Esc)');
+    close.addEventListener('click', () => this.hide());
+    const head = document.createElement('div');
+    head.className = 'point-popup-row';
+    head.append(this.text, close);
+    const buttons = document.createElement('div');
+    buttons.className = 'point-popup-row';
+    for (const [style, label, title] of COPY_BUTTONS) {
+      const button = this.button(label, title);
+      button.addEventListener('click', () => void this.copy(style));
+      buttons.append(button);
+    }
+    this.status = document.createElement('span');
+    this.status.className = 'point-popup-status';
+    buttons.append(this.status);
+    this.root.append(head, buttons);
+    // Clicks inside stay inside (the view under it would take them as a new point).
+    for (const type of ['pointerdown', 'pointerup', 'click', 'wheel'] as const) {
+      this.root.addEventListener(type, (event) => event.stopPropagation());
+    }
+    container.append(this.root);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !this.root.hidden) this.hide();
+    });
+  }
+
+  get open(): boolean {
+    return !this.root.hidden;
+  }
+
+  // At (left, top) in the container's CSS pixels, kept inside it.
+  show(point: [number, number, number], left: number, top: number): void {
+    this.point = point;
+    this.text.value = formatPointText(point[0], point[1], point[2], 'xyz');
+    this.setStatus('');
+    this.root.hidden = false;
+    const width = this.root.offsetWidth;
+    const height = this.root.offsetHeight;
+    const maxLeft = Math.max(4, this.container.clientWidth - width - 4);
+    const maxTop = Math.max(4, this.container.clientHeight - height - 4);
+    this.root.style.left = `${Math.min(Math.max(4, left + 12), maxLeft)}px`;
+    this.root.style.top = `${Math.min(Math.max(4, top + 12), maxTop)}px`;
+    this.text.focus();
+    this.text.select();
+  }
+
+  hide(): void {
+    this.root.hidden = true;
+    this.point = null;
+  }
+
+  private async copy(style: PointTextStyle): Promise<void> {
+    if (!this.point) return;
+    const text = formatPointText(this.point[0], this.point[1], this.point[2], style);
+    try {
+      await navigator.clipboard.writeText(text);
+      this.setStatus('Copied');
+    } catch {
+      // No clipboard API here: copy the selected text the old way, or leave
+      // it selected for Ctrl+C.
+      this.text.value = text;
+      this.text.focus();
+      this.text.select();
+      let copied = false;
+      try {
+        copied = document.execCommand('copy');
+      } catch {
+        copied = false;
+      }
+      this.setStatus(copied ? 'Copied' : 'Ctrl+C to copy');
+    }
+  }
+
+  private setStatus(text: string): void {
+    this.status.textContent = text;
+    if (this.statusTimer) clearTimeout(this.statusTimer);
+    this.statusTimer = text ? setTimeout(() => { this.status.textContent = ''; }, 2000) : null;
+  }
+
+  private button(label: string, title: string): HTMLButtonElement {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'btn btn-tiny';
+    button.textContent = label;
+    button.title = title;
+    return button;
+  }
+}
