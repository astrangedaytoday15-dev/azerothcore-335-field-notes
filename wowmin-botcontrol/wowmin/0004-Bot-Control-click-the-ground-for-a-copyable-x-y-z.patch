+test('a clicked point as text: x y z, the panel moveto, the in-game go', () => {
+  assert.equal(formatPointText(-10238.6, 1219.904, 42.2, 'xyz'), '-10238.60 1219.90 42.20');
+  assert.equal(formatPointText(-10238.6, 1219.904, 42.2, 'go'), 'go -10238.60;1219.90;42.20');
+  const moveto = formatPointText(-10238.6, 1219.904, 42.2, 'moveto');
+  assert.equal(moveto, 'moveto -10238.60 1219.90 42.20');
+  // What the popup copies, the bot panel's text box takes back unchanged.
+  assert.deepEqual(plain(normalizeBotCommand(moveto)), { kind: 'move', command: moveto });
+});
+
 test('botmark lines and replies (B7 module)', () => {
   assert.equal(buildBotMarkLine('Ownerchar', 'skull', { entry: 299, unitId: 805306470 }),
     'wowmin botmark Ownerchar skull 299 805306470');
diff --git a/src/bot-command-rules.ts b/src/bot-command-rules.ts
index 7c7fbf7..e3e2822 100644
--- a/src/bot-command-rules.ts
+++ b/src/bot-command-rules.ts
@@ -68,6 +68,16 @@ export function buildMoveCommand(x: number, y: number, z: number): string {
   return `moveto ${x.toFixed(2)} ${y.toFixed(2)} ${z.toFixed(2)}`;
 }
 
+// A clicked world point as text to send a bot there: "x y z" as is, the
+// panel's "moveto x y z", or "go x;y;z" for a whisper to a bot in game.
+export type PointTextStyle = 'xyz' | 'moveto' | 'go';
+
+export function formatPointText(x: number, y: number, z: number, style: PointTextStyle): string {
+  if (style === 'moveto') return buildMoveCommand(x, y, z);
+  const parts = [x, y, z].map((value) => value.toFixed(2));
+  return style === 'go' ? `go ${parts.join(';')}` : parts.join(' ');
+}
+
 export function buildBotCommandLine(bot: string, command: string): string {
   return `wowmin botcmd ${bot} ${command}`;
 }
