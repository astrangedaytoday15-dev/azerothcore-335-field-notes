From e5f8247df3c84fc65ea155b65b2686a1dea370e1 Mon Sep 17 00:00:00 2001
From: astrangedaytoday15-dev <342675337+astrangedaytoday15-dev@users.noreply.github.com>
Date: Thu, 22 Oct 2026 02:48:42 -0400
Subject: [PATCH] Bot Control: the text box takes a pasted point in any of the
 box's forms

"x y z" and "go x;y;z" (the point box's Copy and go buttons) now count as
"moveto x y z", so Send works whichever was pasted. The server gets the
rebuilt "moveto" line as before; ";" never reaches the console.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/test-bot-command.cjs | 7 ++++++-
 src/bot-command-rules.ts     | 6 ++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/scripts/test-bot-command.cjs b/scripts/test-bot-command.cjs
index 7b9252a..c303dea 100644
--- a/scripts/test-bot-command.cjs
+++ b/scripts/test-bot-command.cjs
@@ -222,8 +222,13 @@ test('moveto: three plain numbers, sent with two decimals (B7 module)', () => {
     kind: 'move', command: 'moveto -10238.60 1219.90 42.20',
   });
   assert.deepEqual(plain(normalizeBotCommand('moveto  1 2  3')), { kind: 'move', command: 'moveto 1.00 2.00 3.00' });
+  // The point box's other two forms are the same move.
+  for (const text of ['-10238.6 1219.9 42.2', 'go -10238.6;1219.9;42.2', ' go -10238.6; 1219.9 ;42.2 ']) {
+    assert.deepEqual(plain(normalizeBotCommand(text)), { kind: 'move', command: 'moveto -10238.60 1219.90 42.20' }, text);
+  }
   for (const text of ['moveto -10238.6;1219.9;42.2', 'moveto 1 2', 'moveto 1 2 3 4', 'moveto 1e3 2 3', 'moveto x 2 3',
-    'moveto 1 2 NaN', 'Moveto 1 2 3', 'moveto +1 2 3', 'go 1;2;3']) {
+    'moveto 1 2 NaN', 'Moveto 1 2 3', 'moveto +1 2 3', 'go 1;2', '1 2', '1 2 3 4', '1..2 3 4', 'go 1;2;3;4',
+    'go travel 1;2;3', 'stay 1 2 3']) {
     assert.equal(normalizeBotCommand(text), null, text);
   }
 });
diff --git a/src/bot-command-rules.ts b/src/bot-command-rules.ts
index e3e2822..ff396bb 100644
--- a/src/bot-command-rules.ts
+++ b/src/bot-command-rules.ts
@@ -33,8 +33,10 @@ export function parseBotName(name: unknown): string | null {
 export function normalizeBotCommand(text: unknown): NormalizedBotCommand | null {
   if (typeof text !== 'string') return null;
   const joined = text.split(/\s+/).filter(Boolean).join(' ');
-  // "moveto <x> <y> <z>": the module builds "go x;y;z" itself.
-  const move = /^moveto (\S+) (\S+) (\S+)$/.exec(joined);
+  // "moveto <x> <y> <z>": the module builds "go x;y;z" itself. A point as the
+  // point box copies it ("x y z" or "go x;y;z") counts as the same move.
+  const move = /^moveto (\S+) (\S+) (\S+)$/.exec(joined)
+    ?? /^(?:go )?(-?[\d.]+)[ ;](-?[\d.]+)[ ;](-?[\d.]+)$/.exec(joined.replace(/ ?; ?/g, ';'));
   if (move) {
     const point = move.slice(1).map(parseMoveNumber);
     return point.every((value) => value !== null)
-- 
