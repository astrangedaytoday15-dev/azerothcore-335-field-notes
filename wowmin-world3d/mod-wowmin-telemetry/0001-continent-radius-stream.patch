+// What a continent stream sends: units within `radius` yards (on the flat)
+// of the followed player. Radius 0: the whole map (instances).
+struct StreamArea
+{
+    float x = 0.0f;
+    float y = 0.0f;
+    float radius = 0.0f;
+
+    bool Contains(WorldObject const* object) const
+    {
+        return radius <= 0.0f || object->GetExactDist2dSq(x, y) <= radius * radius;
+    }
+};
+
 struct StreamSubscription
