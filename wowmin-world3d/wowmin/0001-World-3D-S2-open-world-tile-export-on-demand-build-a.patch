@@ -0,0 +1,150 @@
+import { fork, type ChildProcess } from 'child_process';
+import * as fs from 'fs';
+import * as path from 'path';
+
+// World 3D's open-world tile scenes (scripts/scene/export-tile.mjs), built
+// on demand from the WoW client's Data directory in a child process and
+// cached under the world tile directory: <root>/v<version>/<mapId>/<x>_<y>.glb
+// and .scene.json, or <x>_<y>.empty for a tile the map has none for. Needs
+// WOWMIN_CLIENT_DATA; without it only what is already cached is served.
+
+// A tile takes about 10 s (Hillsbrad, measured); several may queue ahead.
+const BUILD_TIMEOUT_MS = 5 * 60 * 1000;
+// Bumped when the tile exporter's output changes, so tiles are rebuilt.
+export const WORLD_TILE_CACHE_VERSION = 1;
+// A tile that could not be built is not retried for this long.
+const FAILURE_RETRY_MS = 10 * 60 * 1000;
+// Window sizes the viewer may ask for (odd, centred on the followed unit).
+export const WORLD_WINDOW_DEFAULT = 3;
+export const WORLD_WINDOW_MAX = 7;
+
+export interface WorldTileRequest {
+  mapId: number;
+  x: number;
+  y: number;
+  file: 'glb' | 'scene.json';
+}
+
+// Parses /assets/world/<mapId>/<x>_<y>.glb (or .scene.json).
+export function parseWorldTilePath(urlPath: string): WorldTileRequest | null {
+  const match = urlPath.match(/^\/assets\/world\/(\d{1,4})\/(\d{1,2})_(\d{1,2})\.(glb|scene\.json)$/);
+  if (!match) return null;
+  const [, mapId, x, y, file] = match;
+  const request = { mapId: Number(mapId), x: Number(x), y: Number(y), file: file as WorldTileRequest['file'] };
+  return request.x < 64 && request.y < 64 ? request : null;
+}
+
+// WOWMIN_WORLD3D_TILES: the window's size in tiles per side, an odd number
+// from 1 to WORLD_WINDOW_MAX; anything else falls back to the default.
+export function worldWindowSize(value: string | undefined): number {
+  const size = Number(value);
+  return Number.isInteger(size) && size >= 1 && size <= WORLD_WINDOW_MAX && size % 2 === 1 ? size : WORLD_WINDOW_DEFAULT;
+}
+
+interface PendingBuild {
+  resolve: (result: 'built' | 'empty' | 'failed') => void;
+  timer: ReturnType<typeof setTimeout>;
+}
+
+export class WorldTiles {
+  private worker: ChildProcess | null = null;
+  private nextId = 1;
+  private readonly pending = new Map<number, PendingBuild>();
+  private readonly building = new Map<string, Promise<'built' | 'empty' | 'failed'>>();
+  private readonly failedAt = new Map<string, number>();
+
+  constructor(private readonly cacheRoot: string, private readonly workerScript: string) {
+    this.removeOldVersions();
+  }
+
+  get enabled(): boolean {
+    return Boolean(process.env.WOWMIN_CLIENT_DATA);
+  }
+
+  private mapDir(mapId: number): string {
+    return path.join(this.cacheRoot, `v${WORLD_TILE_CACHE_VERSION}`, String(mapId));
+  }
+
+  pathFor(request: WorldTileRequest): string {
+    return path.join(this.mapDir(request.mapId), `${request.x}_${request.y}.${request.file}`);
+  }
+
+  private removeOldVersions(): void {
+    let entries: string[];
+    try {
+      entries = fs.readdirSync(this.cacheRoot);
+    } catch {
+      return;
+    }
+    for (const entry of entries.filter((name) => /^v\d+$/.test(name) && name !== `v${WORLD_TILE_CACHE_VERSION}`)) {
+      try {
+        fs.rmSync(path.join(this.cacheRoot, entry), { recursive: true, force: true });
+      } catch (error) {
+        console.warn(`Could not remove old world tiles in ${entry}: ${error instanceof Error ? error.message : error}`);
+      }
+    }
+  }
+
+  // Resolves to the cached file, building the tile first if needed; null for
+  // a tile with no terrain (open sea) or one that could not be built.
+  async ensure(request: WorldTileRequest): Promise<string | null> {
+    const filePath = this.pathFor(request);
+    const manifest = this.pathFor({ ...request, file: 'scene.json' });
+    const exists = (file: string) => fs.promises.access(file).then(() => true, () => false);
+    // The manifest is written last, so with it the tile is complete.
+    if (await exists(manifest)) return await exists(filePath) ? filePath : null;
+    const emptyMarker = path.join(this.mapDir(request.mapId), `${request.x}_${request.y}.empty`);
+    if (await exists(emptyMarker) || !this.enabled) return null;
+    const id = `${request.mapId}/${request.x}_${request.y}`;
+    const failedAt = this.failedAt.get(id);
+    if (failedAt !== undefined) {
+      if (Date.now() - failedAt < FAILURE_RETRY_MS) return null;
+      this.failedAt.delete(id);
+    }
+    let build = this.building.get(id);
+    if (!build) {
+      build = this.build(request).finally(() => this.building.delete(id));
+      this.building.set(id, build);
+    }
+    const result = await build;
+    if (result === 'failed') this.failedAt.set(id, Date.now());
+    return result === 'built' ? filePath : null;
+  }
+
+  private build(request: WorldTileRequest): Promise<'built' | 'empty' | 'failed'> {
+    const worker = this.ensureWorker();
+    const id = this.nextId++;
+    return new Promise((resolve) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        resolve('failed');
+      }, BUILD_TIMEOUT_MS);
+      this.pending.set(id, { resolve, timer });
+      worker.send({ id, mapId: request.mapId, x: request.x, y: request.y, outputDir: this.mapDir(request.mapId) });
+    });
+  }
+
+  private ensureWorker(): ChildProcess {
+    if (this.worker) return this.worker;
+    const worker = fork(this.workerScript, [], { stdio: ['ignore', 'inherit', 'inherit', 'ipc'] });
+    worker.on('message', (message: { id: number; ok: boolean; empty?: boolean; error?: string }) => {
+      const pending = this.pending.get(message.id);
+      if (!pending) return;
+      this.pending.delete(message.id);
+      clearTimeout(pending.timer);
+      if (!message.ok && message.error) console.warn(`World tile not built: ${message.error}`);
+      pending.resolve(!message.ok ? 'failed' : message.empty ? 'empty' : 'built');
+    });
+    worker.on('exit', (code) => {
+      if (this.worker === worker) this.worker = null;
+      if (code) console.warn(`World tile worker exited with code ${code}.`);
+      for (const [id, pending] of this.pending) {
+        clearTimeout(pending.timer);
+        pending.resolve('failed');
+        this.pending.delete(id);
+      }
+    });
+    this.worker = worker;
+    return worker;
+  }
+}
