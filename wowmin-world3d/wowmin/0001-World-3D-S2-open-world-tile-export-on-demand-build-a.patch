diff --git a/scripts/export-world-tiles.mjs b/scripts/export-world-tiles.mjs
new file mode 100644
index 0000000..582a25d
--- /dev/null
+++ b/scripts/export-world-tiles.mjs
@@ -0,0 +1,118 @@
+#!/usr/bin/env node
+// Exports World 3D's open-world tile scenes ahead of time: one tile, or the
+// window of tiles around one (scripts/scene/export-tile.mjs). The web
+// service builds missing tiles on demand anyway; this pre-builds an area.
+
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+import { locateDataDir, openClientData } from './client-archives.mjs';
+import { buildMapCatalog } from './map-catalog.mjs';
+import { assertNpmValueOptionsHaveValues, readNpmConfigValue } from './npm-config.mjs';
+import { exportWorldTile, tileWindow } from './scene/export-tile.mjs';
+
+const USAGE = `WoW Admin World 3D tile exporter
+
+Usage:
+  npm run extract:world -- --source /path/to/WoW --map 0 --tile 32 32
+  npm run extract:world -- --source /path/to/WoW --map 0 --around 32 32 --size 3
+
+Options:
+  --source, -s        WoW client root or its Data directory
+  --output, -o        Output directory (default: assets/world); tiles go in <output>/<map>/
+  --map, -m           Map ID (0 Eastern Kingdoms, 1 Kalimdor, 530 Outland, 571 Northrend)
+  --tile X Y          Export this ADT tile (repeatable)
+  --around X Y        Export the window of tiles centred on this tile
+  --size N            Window size for --around, an odd number (default: 3)
+  --scene-texture-max Largest scene texture edge in pixels (default: 512)
+  --help, -h          Show this message
+`;
+
+const NPM_VALUE_OPTIONS = ['source', 'output', 'map', 'size', 'scene_texture_max'];
+
+export function parseWorldTileArgs(argv) {
+  assertNpmValueOptionsHaveValues(NPM_VALUE_OPTIONS);
+  const options = {
+    source: readNpmConfigValue('source') ?? null,
+    output: readNpmConfigValue('output') ?? 'assets/world',
+    mapId: readNpmConfigValue('map') === undefined ? null : Number(readNpmConfigValue('map')),
+    tiles: [],
+    around: null,
+    size: Number(readNpmConfigValue('size') ?? 3),
+    textureMax: Number(readNpmConfigValue('scene_texture_max') ?? 512),
+    help: false,
+  };
+  for (let index = 0; index < argv.length; index += 1) {
+    const arg = argv[index];
+    const value = () => {
+      const next = argv[++index];
+      if (next === undefined) throw new Error(`${arg} needs a value.`);
+      return next;
+    };
+    switch (arg) {
+      case '--source': case '-s': options.source = value(); break;
+      case '--output': case '-o': options.output = value(); break;
+      case '--map': case '-m': options.mapId = Number(value()); break;
+      case '--tile': options.tiles.push({ x: Number(value()), y: Number(value()) }); break;
+      case '--around': options.around = { x: Number(value()), y: Number(value()) }; break;
+      case '--size': options.size = Number(value()); break;
+      case '--scene-texture-max': options.textureMax = Number(value()); break;
+      case '--help': case '-h': options.help = true; break;
+      default: throw new Error(`Unknown argument: ${arg}`);
+    }
+  }
+  if (options.help) return options;
+  if (!options.source) throw new Error('Missing required --source argument.');
+  if (!Number.isInteger(options.mapId) || options.mapId < 0) throw new Error('Pass --map <id>.');
+  if (!options.tiles.length && !options.around) throw new Error('Pass --tile X Y or --around X Y.');
+  if (options.tiles.length && options.around) throw new Error('--tile and --around are mutually exclusive.');
+  if (options.around) options.tiles = tileWindow(options.around.x, options.around.y, options.size);
+  if (!options.tiles.length || options.tiles.some(({ x, y }) => !Number.isInteger(x) || !Number.isInteger(y) || x < 0 || y < 0 || x > 63 || y > 63)) {
+    throw new Error('Tiles must be whole numbers from 0 to 63.');
+  }
+  if (!Number.isInteger(options.textureMax) || options.textureMax < 1) {
+    throw new Error(`Scene texture size must be a positive integer. Received: ${options.textureMax}`);
+  }
+  return { ...options, source: path.resolve(options.source), output: path.resolve(options.output) };
+}
+
+async function main() {
+  const options = parseWorldTileArgs(process.argv.slice(2));
+  if (options.help) {
+    console.log(USAGE);
+    return;
+  }
+  const dataDir = locateDataDir(options.source);
+  if (!dataDir) throw new Error(`No WoW client Data directory at ${options.source}.`);
+  const readFile = openClientData(dataDir, { warn: (message) => console.warn(`  ! ${message}`) });
+  const [map] = buildMapCatalog(readFile, { mapIds: [options.mapId] });
+  if (!map) throw new Error(`Map ${options.mapId} is not in Map.dbc.`);
+  const outputDir = path.join(options.output, String(options.mapId));
+
+  let written = 0;
+  for (const { x, y } of options.tiles) {
+    const started = Date.now();
+    try {
+      const { empty, stats } = await exportWorldTile({
+        mapId: options.mapId, internalName: map.internalName, readFile, outputDir, x, y, textureMax: options.textureMax,
+      });
+      if (empty) {
+        console.log(`• ${map.label} tile ${x},${y}: no terrain (open sea), marked empty`);
+      } else {
+        written += 1;
+        console.log(`• ${map.label} tile ${x},${y}: ${(stats.bytes / 1048576).toFixed(1)} MB, ${stats.wmoCount} WMO, `
+          + `${stats.doodadCount} doodads, ${((Date.now() - started) / 1000).toFixed(1)} s`);
+      }
+    } catch (error) {
+      console.warn(`  ! Skipping tile ${x},${y}: ${error instanceof Error ? error.message : error}`);
+    }
+  }
+  console.log(`\nDone. Wrote ${written} of ${options.tiles.length} tile(s) to ${outputDir}`);
+}
+
+if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {
+  main().catch((error) => {
+    console.error(`✖ ${error instanceof Error ? error.message : error}`);
+    process.exitCode = 1;
+  });
+}
diff --git a/scripts/scene/export-tile.mjs b/scripts/scene/export-tile.mjs
new file mode 100644
index 0000000..2a051d4
--- /dev/null
+++ b/scripts/scene/export-tile.mjs
@@ -0,0 +1,100 @@
+// Builds one open-world map tile's scene for World 3D: <x>_<y>.glb plus its
+// manifest <x>_<y>.scene.json, from one ADT tile of a map (a continent), with
+// the instance scene exporter (export-scene.mjs) unchanged: every other tile
+// of the map reads as missing, and the play area is the tile's own box.
+// Tiles are named by their ADT file numbers (<map>_<x>_<y>.adt): x runs with
+// server Y and y with server X, both counting down from 32 at the map centre.
+// A WMO is kept whole by the tile that places it, so a building over a tile
+// edge reaches past its box (and neighbours can place the same one).
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+import { readWdt } from './placement.mjs';
+import { exportMapScene } from './export-scene.mjs';
+
+export const WORLD_TILE_SCHEMA_VERSION = 1;
+export const TILE_SIZE = 1600 / 3;
+export const TILES_PER_SIDE = 64;
+
+// The server box a tile covers.
+export function tileBounds(x, y) {
+  const maxX = (32 - y) * TILE_SIZE;
+  const maxY = (32 - x) * TILE_SIZE;
+  return { minX: maxX - TILE_SIZE, maxX, minY: maxY - TILE_SIZE, maxY };
+}
+
+// The tile a server position (x north, y west) stands on.
+export function tileAt(serverX, serverY) {
+  return { x: Math.floor(32 - serverY / TILE_SIZE), y: Math.floor(32 - serverX / TILE_SIZE) };
+}
+
+export function isTileInRange(x, y) {
+  return Number.isInteger(x) && Number.isInteger(y) && x >= 0 && y >= 0 && x < TILES_PER_SIDE && y < TILES_PER_SIDE;
+}
+
+// The size x size tiles centred on (x, y), row by row, clipped to the map's
+// grid; size is odd.
+export function tileWindow(x, y, size) {
+  if (!Number.isInteger(size) || size < 1 || size % 2 === 0) throw new Error(`Window size must be an odd number, not ${size}.`);
+  const reach = (size - 1) / 2;
+  const tiles = [];
+  for (let dy = -reach; dy <= reach; dy += 1) {
+    for (let dx = -reach; dx <= reach; dx += 1) {
+      if (isTileInRange(x + dx, y + dy)) tiles.push({ x: x + dx, y: y + dy });
+    }
+  }
+  return tiles;
+}
+
+export const tileBaseName = (x, y) => `${x}_${y}`;
+
+// A readFile that sees only one ADT tile of the map; every other file reads
+// as usual.
+export function onlyTile(readFile, internalName, x, y) {
+  const prefix = `world\\maps\\${internalName}\\${internalName}_`.toLowerCase();
+  const kept = `${prefix}${x}_${y}.adt`;
+  return (name) => {
+    const normal = name.replace(/\//g, '\\').toLowerCase();
+    if (normal.startsWith(prefix) && normal.endsWith('.adt') && normal !== kept) return null;
+    return readFile(name);
+  };
+}
+
+// Writes the tile's scene into outputDir, or an <x>_<y>.empty marker for a
+// tile the map has no ADT for (open sea), so it is not asked for again.
+// Returns { empty, manifest, stats }.
+export async function exportWorldTile({ mapId, internalName, readFile, outputDir, x, y, textureMax = 512 }) {
+  if (!isTileInRange(x, y)) throw new Error(`Tile ${x},${y} is outside the map grid.`);
+  const base = tileBaseName(x, y);
+  fs.mkdirSync(outputDir, { recursive: true });
+  const mapPath = `World\\maps\\${internalName}\\${internalName}`;
+  const wdtBuffer = readFile(`${mapPath}.wdt`);
+  if (!wdtBuffer) throw new Error(`Missing ${mapPath}.wdt`);
+  const wdt = readWdt(wdtBuffer);
+  if (wdt.wmoOnly || !wdt.tiles.some((tile) => tile.x === x && tile.y === y)) {
+    fs.writeFileSync(path.join(outputDir, `${base}.empty`), '');
+    return { empty: true, manifest: null, stats: null };
+  }
+
+  // exportMapScene writes <mapId>.glb; each tile builds in its own folder so
+  // a half-written scene never sits under a tile's name.
+  const workDir = path.join(outputDir, `.build-${base}-${process.pid}`);
+  fs.rmSync(workDir, { recursive: true, force: true });
+  fs.mkdirSync(workDir, { recursive: true });
+  try {
+    const bounds = tileBounds(x, y);
+    const { scene, stats } = await exportMapScene({
+      mapId, internalName, readFile: onlyTile(readFile, internalName, x, y), outputDir: workDir, textureMax, worldMapBounds: bounds,
+    });
+    const manifest = {
+      schemaVersion: WORLD_TILE_SCHEMA_VERSION, mapId, tile: [x, y], tileBounds: bounds, ...scene, file: `${base}.glb`,
+    };
+    fs.renameSync(path.join(workDir, scene.file), path.join(outputDir, `${base}.glb`));
+    // The manifest last: its presence means the tile is complete.
+    fs.writeFileSync(path.join(outputDir, `${base}.scene.json`), `${JSON.stringify(manifest, null, 2)}\n`);
+    return { empty: false, manifest, stats };
+  } finally {
+    fs.rmSync(workDir, { recursive: true, force: true });
+  }
+}
diff --git a/scripts/scene/world-tile-worker.mjs b/scripts/scene/world-tile-worker.mjs
new file mode 100644
index 0000000..41c657f
--- /dev/null
+++ b/scripts/scene/world-tile-worker.mjs
@@ -0,0 +1,43 @@
+// Child process of the web server that builds World 3D's open-world tile
+// scenes (export-tile.mjs) from the WoW client's Data directory on request,
+// into the folder it is given. Messages in: { id, mapId, x, y, outputDir };
+// out: { id, ok, empty?, error? }. Client archives are opened once, on the
+// first request; tiles build one at a time, in the order asked.
+
+import { openClientData } from '../client-archives.mjs';
+import { buildMapCatalog } from '../map-catalog.mjs';
+import { exportWorldTile } from './export-tile.mjs';
+
+let readFile = null;
+const mapNames = new Map();
+
+function clientFiles() {
+  if (!readFile) {
+    const dataDir = process.env.WOWMIN_CLIENT_DATA;
+    if (!dataDir) throw new Error('WOWMIN_CLIENT_DATA is not set.');
+    readFile = openClientData(dataDir, { warn: (message) => console.warn(`[world tiles] ${message}`) });
+  }
+  return readFile;
+}
+
+function internalName(mapId) {
+  if (!mapNames.has(mapId)) {
+    const [map] = buildMapCatalog(clientFiles(), { mapIds: [mapId] });
+    if (!map) throw new Error(`Map ${mapId} is not in Map.dbc.`);
+    mapNames.set(mapId, map.internalName);
+  }
+  return mapNames.get(mapId);
+}
+
+let queue = Promise.resolve();
+
+process.on('message', ({ id, mapId, x, y, outputDir }) => {
+  queue = queue.then(async () => {
+    try {
+      const { empty } = await exportWorldTile({ mapId, internalName: internalName(mapId), readFile: clientFiles(), outputDir, x, y });
+      process.send({ id, ok: true, empty });
+    } catch (error) {
+      process.send({ id, ok: false, error: error instanceof Error ? error.message : String(error) });
+    }
+  });
+});
diff --git a/scripts/test-world-tiles.cjs b/scripts/test-world-tiles.cjs
new file mode 100644
index 0000000..291df59
--- /dev/null
+++ b/scripts/test-world-tiles.cjs
@@ -0,0 +1,95 @@
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { test } = require('node:test');
+const { pathToFileURL } = require('node:url');
+const vm = require('node:vm');
+const esbuild = require('esbuild');
+
+// World 3D's open-world tiles: tile maths, the export window, the one-tile
+// file filter, the exporter's options, and the web service's tile paths.
+// None of these use Blizzard files.
+
+const tiles = import(pathToFileURL(path.join(__dirname, 'scene', 'export-tile.mjs')).href);
+const cli = import(pathToFileURL(path.join(__dirname, 'export-world-tiles.mjs')).href);
+
+function loadModule(relativePath) {
+  const output = esbuild.buildSync({
+    entryPoints: [path.join(__dirname, relativePath)],
+    bundle: true,
+    write: false,
+    platform: 'node',
+    format: 'cjs',
+  }).outputFiles[0].text;
+  const context = { module: { exports: {} }, require, Buffer, process, console, setTimeout, clearTimeout };
+  context.exports = context.module.exports;
+  vm.runInNewContext(output, context);
+  return context.module.exports;
+}
+
+const { parseWorldTilePath, worldWindowSize } = loadModule('../src/world-tiles.ts');
+
+test('a server position stands on the tile whose box holds it', async () => {
+  const { tileAt, tileBounds, TILE_SIZE } = await tiles;
+  // Hillsbrad bots (S97 spike): Darin on 32,32 and Morl on 33,32.
+  assert.deepEqual(tileAt(-467, -163.5), { x: 32, y: 32 });
+  assert.deepEqual(tileAt(-263.8, -656.3), { x: 33, y: 32 });
+  assert.deepEqual(tileBounds(32, 32), { minX: -TILE_SIZE, maxX: 0, minY: -TILE_SIZE, maxY: 0 });
+  for (const [x, y] of [[-467, -163.5], [-263.8, -656.3], [1676, -4315], [-8913, 554]]) {
+    const tile = tileAt(x, y);
+    const box = tileBounds(tile.x, tile.y);
+    assert.ok(x >= box.minX && x < box.maxX && y >= box.minY && y < box.maxY, `${x},${y} in tile ${tile.x},${tile.y}`);
+  }
+});
+
+test('the window is size x size tiles round the centre, clipped to the grid', async () => {
+  const { tileWindow } = await tiles;
+  assert.equal(tileWindow(32, 32, 3).length, 9);
+  assert.deepEqual(tileWindow(32, 32, 1), [{ x: 32, y: 32 }]);
+  assert.deepEqual(tileWindow(32, 32, 3)[0], { x: 31, y: 31 });
+  assert.deepEqual(tileWindow(32, 32, 3)[8], { x: 33, y: 33 });
+  assert.equal(tileWindow(0, 0, 3).length, 4);
+  assert.equal(tileWindow(63, 10, 5).length, 15);
+  assert.throws(() => tileWindow(32, 32, 4), /odd number/);
+  assert.throws(() => tileWindow(32, 32, 0), /odd number/);
+});
+
+test('the exporter sees only its own tile of the map', async () => {
+  const { onlyTile } = await tiles;
+  const asked = [];
+  const readFile = onlyTile((name) => { asked.push(name); return Buffer.from(name); }, 'Azeroth', 32, 32);
+  assert.ok(readFile('World\\maps\\Azeroth\\Azeroth_32_32.adt'));
+  assert.ok(readFile('world/maps/azeroth/azeroth_32_32.adt'));
+  assert.equal(readFile('World\\maps\\Azeroth\\Azeroth_32_33.adt'), null);
+  assert.equal(readFile('World\\maps\\Azeroth\\Azeroth_31_32.adt'), null);
+  assert.ok(readFile('World\\maps\\Azeroth\\Azeroth.wdt'));
+  assert.ok(readFile('World\\wmo\\Azeroth\\Buildings\\Farmhouse.wmo'));
+  assert.equal(asked.length, 4);
+});
+
+test('world tile export options need a source, a map, and tiles', async () => {
+  const { parseWorldTileArgs } = await cli;
+  const one = parseWorldTileArgs(['--source', '/wow', '--map', '0', '--tile', '32', '32', '--tile', '33', '32']);
+  assert.deepEqual(one.tiles, [{ x: 32, y: 32 }, { x: 33, y: 32 }]);
+  assert.equal(one.output, path.resolve('assets/world'));
+  assert.equal(parseWorldTileArgs(['--source', '/wow', '--map', '0', '--around', '32', '32']).tiles.length, 9);
+  assert.equal(parseWorldTileArgs(['--source', '/wow', '-m', '1', '--around', '40', '30', '--size', '5']).tiles.length, 25);
+  assert.throws(() => parseWorldTileArgs(['--map', '0', '--tile', '1', '1']), /--source/);
+  assert.throws(() => parseWorldTileArgs(['--source', '/wow', '--tile', '1', '1']), /--map/);
+  assert.throws(() => parseWorldTileArgs(['--source', '/wow', '--map', '0']), /--tile X Y or --around X Y/);
+  assert.throws(() => parseWorldTileArgs(['--source', '/wow', '--map', '0', '--tile', '1', '1', '--around', '1', '1']), /mutually exclusive/);
+  assert.throws(() => parseWorldTileArgs(['--source', '/wow', '--map', '0', '--tile', '64', '1']), /0 to 63/);
+  assert.throws(() => parseWorldTileArgs(['--source', '/wow', '--map', '0', '--around', '1', '1', '--size', '2']), /odd number/);
+});
+
+test('the web service maps tile URLs to tiles and reads the window size', () => {
+  assert.deepEqual(JSON.parse(JSON.stringify(parseWorldTilePath('/assets/world/0/32_32.glb'))), { mapId: 0, x: 32, y: 32, file: 'glb' });
+  assert.equal(parseWorldTilePath('/assets/world/571/10_9.scene.json').file, 'scene.json');
+  assert.equal(parseWorldTilePath('/assets/world/0/64_1.glb'), null);
+  assert.equal(parseWorldTilePath('/assets/world/0/../x.glb'), null);
+  assert.equal(parseWorldTilePath('/assets/world/0/32_32.png'), null);
+  assert.equal(worldWindowSize(undefined), 3);
+  assert.equal(worldWindowSize('5'), 5);
+  assert.equal(worldWindowSize('4'), 3);
+  assert.equal(worldWindowSize('9'), 3);
+  assert.equal(worldWindowSize('x'), 3);
+});
