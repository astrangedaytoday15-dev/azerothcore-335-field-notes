+  const inside = (x, y) => { const box = tileBounds(x, y); return [(box.minX + box.maxX) / 2, (box.minY + box.maxY) / 2, 0]; };
+  // Origin on 33,32, which lists it: both tiles agree on 33,32.
+  const edge = { uniqueId: 7, position: inside(33, 32) };
+  assert.deepEqual(placementOwner(edge, 32, 32, listed), { x: 33, y: 32 });
+  assert.deepEqual(placementOwner(edge, 33, 32, listed), { x: 33, y: 32 });
+  // Origin on a tile that does not list it: the first listing tile, row by row.
+  const off = { uniqueId: 7, position: inside(40, 40) };
+  assert.deepEqual(placementOwner(off, 32, 32, listed), { x: 32, y: 32 });
+  assert.deepEqual(placementOwner(off, 33, 32, listed), { x: 32, y: 32 });
+  // Only one tile lists it: that one.
+  assert.deepEqual(placementOwner({ uniqueId: 8, position: inside(33, 32) }, 32, 32, listed), { x: 32, y: 32 });
+});
+
+const {
+  WorldFollowWindow, worldTileAt, worldTileBounds, worldTilePath, worldTilesToLoad, worldTileWindow, WORLD_WINDOW_HYSTERESIS,
+} = loadModule('../renderer/scripts/utils/world-window.ts');
+
+test('the viewer finds the same tiles as the exporter, nearest the centre first', async () => {
+  const { tileAt, tileBounds, tileWindow } = await tiles;
+  for (const [x, y] of [[-467, -163.5], [-263.8, -656.3], [1676, -4315], [-8913, 554]]) {
+    assert.deepEqual({ ...worldTileAt(x, y) }, tileAt(x, y));
+    const tile = tileAt(x, y);
+    assert.deepEqual({ ...worldTileBounds(tile) }, tileBounds(tile.x, tile.y));
+  }
+  const window = worldTileWindow({ x: 32, y: 32 }, 3).map((tile) => ({ ...tile }));
+  assert.deepEqual(window[0], { x: 32, y: 32 });
+  assert.deepEqual([...window].sort((a, b) => a.y - b.y || a.x - b.x), tileWindow(32, 32, 3));
+  assert.equal(worldTileWindow({ x: 0, y: 0 }, 3).length, 4);
+  assert.equal(worldTilePath(0, { x: 32, y: 31 }), 'assets/world/0/32_31.glb');
+});
+
+test('the follow window moves a row at a time and keeps a few tiles behind', () => {
+  const follow = new WorldFollowWindow(3);
+  const centre = (tile) => { const box = worldTileBounds(tile); return [(box.minX + box.maxX) / 2, (box.minY + box.maxY) / 2]; };
+  let update = follow.update(0, ...centre({ x: 32, y: 32 }));
+  assert.equal(update.paths.length, 9);
+  assert.equal(update.paths[0], 'assets/world/0/32_32.glb');
+  assert.equal(update.drop.length, 0);
+  // Just past the edge into 33,32 (server Y falls going east): no move yet.
+  const box = worldTileBounds({ x: 32, y: 32 });
+  update = follow.update(0, centre({ x: 32, y: 32 })[0], box.minY - WORLD_WINDOW_HYSTERESIS / 2);
+  assert.equal(update.centre.x, 32);
+  // Well into 33,32: one column in, one left behind but kept.
+  update = follow.update(0, ...centre({ x: 33, y: 32 }));
+  assert.deepEqual({ ...update.centre }, { x: 33, y: 32 });
+  assert.ok(update.paths.includes('assets/world/0/34_32.glb'));
+  assert.ok(!update.paths.includes('assets/world/0/31_32.glb'));
+  assert.equal(update.drop.length, 0);
+  // Another column: the kept ones beyond three are dropped, oldest first.
+  update = follow.update(0, ...centre({ x: 34, y: 32 }));
+  assert.equal(update.drop.length, 3);
+  assert.ok(update.drop.every((path) => path.startsWith('assets/world/0/31_')));
+  // Back one column: the kept tiles come back without a reload.
+  update = follow.update(0, ...centre({ x: 33, y: 32 }));
+  assert.equal(update.drop.length, 0);
+  assert.ok(update.paths.includes('assets/world/0/32_32.glb'));
+  // A new map lets every tile go.
+  update = follow.update(1, ...centre({ x: 30, y: 30 }));
+  assert.equal(update.drop.length, 12);
+  assert.ok(update.paths.every((path) => path.startsWith('assets/world/1/')));
+  assert.equal(follow.clear().length, 9);
+});
+
+test('tiles load a couple at a time, nearest first', () => {
+  const paths = ['a', 'b', 'c', 'd'];
+  const states = new Map();
+  const state = (path) => states.get(path);
+  assert.deepEqual([...worldTilesToLoad(paths, state)], ['a', 'b']);
+  states.set('a', 'loading').set('b', 'loading');
+  assert.equal(worldTilesToLoad(paths, state).length, 0);
+  states.set('a', 'ready');
+  assert.deepEqual([...worldTilesToLoad(paths, state)], ['c']);
+  states.set('b', 'failed').set('c', 'ready');
+  assert.deepEqual([...worldTilesToLoad(paths, state)], ['d']);
+});
