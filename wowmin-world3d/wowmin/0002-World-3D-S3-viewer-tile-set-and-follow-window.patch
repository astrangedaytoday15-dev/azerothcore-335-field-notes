diff --git a/renderer/scripts/utils/world-window.ts b/renderer/scripts/utils/world-window.ts
new file mode 100644
index 0000000..16353c2
--- /dev/null
+++ b/renderer/scripts/utils/world-window.ts
@@ -0,0 +1,120 @@
+// World 3D's follow window: the size x size open-world tiles round one
+// followed unit, as tile scene paths (served by the web service, built on
+// first ask: src/world-tiles.ts), and which loaded tiles to let go as the
+// unit moves on. Tiles are named by their ADT file numbers, as the exporter
+// names them (scripts/scene/export-tile.mjs): x runs with server Y and y with
+// server X, both counting down from 32 at the map centre.
+
+export const WORLD_TILE_SIZE = 1600 / 3;
+const TILES_PER_SIDE = 64;
+// The unit moves this far past its tile's edge before the window follows,
+// so walking along an edge does not swap rows back and forth.
+export const WORLD_WINDOW_HYSTERESIS = 40;
+
+export interface WorldTile {
+  x: number;
+  y: number;
+}
+
+export interface WorldWindowUpdate {
+  mapId: number;
+  centre: WorldTile;
+  // The window's tile paths, nearest the centre first (the order to ask for
+  // them, as tiles are built one at a time).
+  paths: string[];
+  // Paths no longer kept, to unload.
+  drop: string[];
+}
+
+export function worldTileAt(serverX: number, serverY: number): WorldTile {
+  return { x: Math.floor(32 - serverY / WORLD_TILE_SIZE), y: Math.floor(32 - serverX / WORLD_TILE_SIZE) };
+}
+
+// The server box a tile covers.
+export function worldTileBounds({ x, y }: WorldTile): { minX: number; maxX: number; minY: number; maxY: number } {
+  const maxX = (32 - y) * WORLD_TILE_SIZE;
+  const maxY = (32 - x) * WORLD_TILE_SIZE;
+  return { minX: maxX - WORLD_TILE_SIZE, maxX, minY: maxY - WORLD_TILE_SIZE, maxY };
+}
+
+// The size x size tiles round `centre` that are on the map's grid, nearest
+// first (then row by row); size is odd.
+export function worldTileWindow(centre: WorldTile, size: number): WorldTile[] {
+  const reach = Math.floor(size / 2);
+  const tiles: WorldTile[] = [];
+  for (let dy = -reach; dy <= reach; dy += 1) {
+    for (let dx = -reach; dx <= reach; dx += 1) {
+      const tile = { x: centre.x + dx, y: centre.y + dy };
+      if (tile.x >= 0 && tile.y >= 0 && tile.x < TILES_PER_SIDE && tile.y < TILES_PER_SIDE) tiles.push(tile);
+    }
+  }
+  const distance = (tile: WorldTile) => Math.max(Math.abs(tile.x - centre.x), Math.abs(tile.y - centre.y));
+  return tiles.sort((a, b) => distance(a) - distance(b));
+}
+
+// Tiles asked for at once: the web service holds each request open while it
+// builds the tile (one at a time, seconds each), and the browser has only a
+// few connections to it for everything else.
+export const WORLD_TILE_LOADS = 2;
+
+// The window's tiles to start loading now, nearest first, so that at most
+// `limit` are loading at once; `state` is the viewer's (undefined before a
+// load starts).
+export function worldTilesToLoad(paths: readonly string[], state: (path: string) => string | undefined, limit = WORLD_TILE_LOADS): string[] {
+  const loading = paths.filter((path) => state(path) === 'loading').length;
+  return paths.filter((path) => state(path) === undefined).slice(0, Math.max(0, limit - loading));
+}
+
+export function worldTilePath(mapId: number, { x, y }: WorldTile): string {
+  return `assets/world/${mapId}/${x}_${y}.glb`;
+}
+
+// Follows one unit: the window's centre moves when the unit leaves the
+// centre tile (by more than the hysteresis) or changes map. Tiles that drop
+// out of the window stay loaded, the most recent `keep` of them, for when
+// the unit turns back.
+export class WorldFollowWindow {
+  private mapId: number | null = null;
+  private centre: WorldTile | null = null;
+  private paths: string[] = [];
+  // Left behind, oldest first.
+  private kept: string[] = [];
+
+  constructor(readonly size: number, private readonly keep = size) {}
+
+  update(mapId: number, serverX: number, serverY: number): WorldWindowUpdate {
+    const drop: string[] = [];
+    if (mapId !== this.mapId) {
+      drop.push(...this.paths, ...this.kept);
+      this.paths = [];
+      this.kept = [];
+      this.centre = null;
+      this.mapId = mapId;
+    }
+    if (!this.centre || !this.holds(this.centre, serverX, serverY)) {
+      this.centre = worldTileAt(serverX, serverY);
+      const paths = worldTileWindow(this.centre, this.size).map((tile) => worldTilePath(mapId, tile));
+      const left = this.paths.filter((path) => !paths.includes(path));
+      this.kept = [...this.kept.filter((path) => !paths.includes(path) && !left.includes(path)), ...left];
+      drop.push(...this.kept.splice(0, Math.max(0, this.kept.length - this.keep)));
+      this.paths = paths;
+    }
+    return { mapId, centre: this.centre, paths: this.paths, drop };
+  }
+
+  // Lets every tile go (the view closed).
+  clear(): string[] {
+    const drop = [...this.paths, ...this.kept];
+    this.mapId = null;
+    this.centre = null;
+    this.paths = [];
+    this.kept = [];
+    return drop;
+  }
+
+  private holds(tile: WorldTile, serverX: number, serverY: number): boolean {
+    const box = worldTileBounds(tile);
+    const pad = WORLD_WINDOW_HYSTERESIS;
+    return serverX >= box.minX - pad && serverX < box.maxX + pad && serverY >= box.minY - pad && serverY < box.maxY + pad;
+  }
+}
