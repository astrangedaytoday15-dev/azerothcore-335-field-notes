+// The tile that draws a placement listed in tile (x, y)'s ADT: the tile under
+// its origin when that tile's ADT lists it too; otherwise (an origin off the
+// building, or on a tile that does not list it) the first tile, row by row,
+// of (x, y) and its neighbours that lists it. `listed(tileX, tileY)` is the
+// set of uniqueIds a tile's ADT lists, or null without one. Tiles that list
+// the same placement agree as long as they are all neighbours.
+export function placementOwner(placement, x, y, listed) {
+  const origin = tileAt(placement.position[0], placement.position[1]);
+  if (isTileInRange(origin.x, origin.y) && listed(origin.x, origin.y)?.has(placement.uniqueId)) return origin;
+  return tileWindow(x, y, 3).find((tile) => listed(tile.x, tile.y)?.has(placement.uniqueId)) ?? { x, y };
+}
+
+// listed() for placementOwner from the map's ADTs, each read once.
+function listedPlacements(readFile, internalName) {
+  const cache = new Map();
+  return (x, y) => {
+    const key = tileBaseName(x, y);
+    if (!cache.has(key)) {
+      const buffer = readFile(`World\\maps\\${internalName}\\${internalName}_${x}_${y}.adt`);
+      const placements = buffer ? readAdtPlacements(buffer) : null;
+      cache.set(key, placements && new Set([...placements.wmos, ...placements.doodads].map((placement) => placement.uniqueId)));
+    }
+    return cache.get(key);
+  };
+}
