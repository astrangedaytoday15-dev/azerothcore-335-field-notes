+    onGameObjects: (update) => { if (current()) world3dLive.gameObjects.push(update, performance.now()); },
+    onUnitAuras: (update) => { if (current()) world3dLive.auras.push(update, performance.now()); },
+    onCombatEvents: (update) => { if (current()) world3dLive.effects.push(update, performance.now()); },
+  }, { name: player.name, radius: world3dStreamRadius });
+  world3dStream = stream;
