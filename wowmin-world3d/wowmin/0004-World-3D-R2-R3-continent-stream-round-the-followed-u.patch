+function syncWorld3dStream(player: MapPlayerPosition | null): void {
+  const wanted = player && world3dName && state.connected && WORLD3D_CONTINENTS.has(player.map)
+    ? `${player.map}:${player.name}:${world3dStreamRadius}` : null;
+  if ((world3dStream?.key ?? null) === wanted) return;
+  world3dStream?.stop();
+  world3dStream = null;
+  for (const store of Object.values(world3dLive)) store.clear();
+  if (!wanted || !player) return;
+  const stream: { key: string; stop: () => void; status: StreamStatus } = { key: wanted, stop: () => {}, status: 'starting' };
+  const current = () => world3dStream === stream;
+  stream.stop = window.wowminAPI.map.streamPositions(player.map, 0, {
+    onFrame: (frame) => { if (current()) world3dLive.positions.push(frame, performance.now()); },
+    onStatus: (status) => { if (current()) stream.status = status; },
+    onCreatures: (update) => {
+      if (!current()) return;
