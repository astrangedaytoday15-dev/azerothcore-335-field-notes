@@ -9924,6 +9927,20 @@ function closeWorld3dTiles(): void {
   for (const path of world3dFollow.clear()) view?.unload(world3dTileUrl(path));
 }
 
+// The window size set on the web service; shown in the panel, not editable
+// there. A window already open is rebuilt at the new size.
+function setWorld3dTiles(size: number): void {
+  if (!Number.isInteger(size) || size < 1 || size % 2 !== 1 || size === world3dFollow.size) return;
+  closeWorld3dTiles();
+  world3dFollow = new WorldFollowWindow(size);
+  if ($world3dWindow) $world3dWindow.textContent = `${size}×${size}`;
+  world3dLastDraw = 0;
+}
+
+void window.wowminAPI.app.getBootstrap()
+  .then((bootstrap) => setWorld3dTiles(bootstrap.world3dTiles))
+  .catch(() => { /* keeps the default */ });
+
 function closeWorld3d(): void {
   closeWorld3dTiles();
   world3dTrails.clear();
